<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Erreur' %> - iVote
    </title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-in {
            animation: fadeIn 0.5s ease-out;
        }
    </style>
</head>

<body class="bg-gray-50 min-h-screen flex items-center justify-center p-4">
    <div class="max-w-2xl w-full animate-fade-in">
        <!-- Card principal -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <!-- Header avec couleur selon le type d'erreur -->
            <div
                class="<%= (typeof status !== 'undefined' && status === 403) ? 'bg-red-500' : (status === 404) ? 'bg-yellow-500' : 'bg-blue-500' %> px-6 py-4">
                <div class="flex items-center justify-between text-white">
                    <div class="flex items-center space-x-3">
                        <span class="material-icons text-4xl">
                            <%= (typeof status !=='undefined' && status===403) ? 'block' : (status===404) ? 'search_off'
                                : 'error_outline' %>
                        </span>
                        <div>
                            <h1 class="text-2xl font-bold">
                                <%= title || 'Erreur' %>
                            </h1>
                            <% if (typeof status !=='undefined' && status) { %>
                                <p class="text-sm opacity-90">Code: <%= status %>
                                </p>
                                <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contenu -->
            <div class="p-8">
                <div class="mb-8">
                    <p class="text-gray-700 text-lg leading-relaxed">
                        <%= message || 'Une erreur est survenue' %>
                    </p>
                </div>

                <!-- Actions -->
                <div class="flex flex-col sm:flex-row gap-4">
                    <button onclick="history.back()"
                        class="flex items-center justify-center px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors duration-200">
                        <span class="material-icons mr-2">arrow_back</span>
                        Retour
                    </button>

                    <% if (typeof user !=='undefined' && user) { %>
                        <a href="/dashboard"
                            class="flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors duration-200">
                            <span class="material-icons mr-2">dashboard</span>
                            Tableau de bord
                        </a>
                        <a href="/rooms"
                            class="flex items-center justify-center px-6 py-3 bg-white hover:bg-gray-50 text-blue-600 border-2 border-blue-600 rounded-lg font-medium transition-colors duration-200">
                            <span class="material-icons mr-2">meeting_room</span>
                            Mes Rooms
                        </a>
                        <% } else { %>
                            <a href="/"
                                class="flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors duration-200">
                                <span class="material-icons mr-2">home</span>
                                Accueil
                            </a>
                            <% } %>
                </div>
            </div>

            <!-- Footer avec informations supplémentaires -->
            <div class="bg-gray-50 px-6 py-4 border-t border-gray-200">
                <div class="flex items-start space-x-2 text-sm text-gray-600">
                    <span class="material-icons text-lg">info</span>
                    <div>
                        <p class="font-medium mb-1">Besoin d'aide ?</p>
                        <p class="text-xs">
                            Si ce problème persiste, veuillez contacter l'administrateur ou réessayer plus tard.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message additionnel selon le type d'erreur -->
        <% if (typeof status !=='undefined' ) { %>
            <div class="mt-4 bg-white rounded-lg shadow p-4 text-center">
                <% if (status===403) { %>
                    <p class="text-gray-600 text-sm">
                        <span class="material-icons text-base align-middle text-red-500">lock</span>
                        Vous n'avez pas les permissions nécessaires pour accéder à cette ressource.
                    </p>
                    <% } else if (status===404) { %>
                        <p class="text-gray-600 text-sm">
                            <span class="material-icons text-base align-middle text-yellow-500">search_off</span>
                            La page que vous recherchez n'existe pas ou a été déplacée.
                        </p>
                        <% } else if (status===500) { %>
                            <p class="text-gray-600 text-sm">
                                <span class="material-icons text-base align-middle text-blue-500">build</span>
                                Une erreur technique s'est produite. Nos équipes ont été notifiées.
                            </p>
                            <% } %>
            </div>
            <% } %>
    </div>
</body>

</html>