<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %> | iVote
    </title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            background: #f5f7ff;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            overflow-x: hidden;
        }

        /* Sidebar fixe */
        .sidebar-container {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 16rem;
            /* 64 = 16rem */
            z-index: 40;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* Contenu principal avec marge pour le sidebar */
        .main-content {
            margin-left: 16rem;
            /* Même largeur que le sidebar */
            width: calc(100% - 16rem);
            min-height: 100vh;
        }

        /* Pour les écrans mobiles, on cache le sidebar */
        @media (max-width: 768px) {
            .sidebar-container {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }

            .sidebar-container.active {
                transform: translateX(0);
            }

            .main-content {
                margin-left: 0;
                width: 100%;
            }
        }

        .sidebar-btn {
            transition: all 0.3s ease;
        }

        .sidebar-btn:hover {
            background: #f1f5f9;
        }

        .sidebar-btn.active {
            background: #6366f1;
            color: white;
        }

        .stat-card {
            transition: transform 0.3s ease;
        }

        .stat-card:hover {
            transform: translateY(-5px);
        }

        .voting-card {
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .voting-card:hover {
            border-color: #6366f1;
            transform: translateY(-2px);
        }

        .option-selected {
            background-color: #6366f1 !important;
            color: white !important;
            border-color: #6366f1 !important;
        }

        .notification-dot {
            position: absolute;
            top: 2px;
            right: 2px;
            width: 8px;
            height: 8px;
            background-color: #ef4444;
            border-radius: 50%;
        }

        .user-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            z-index: 50;
        }

        .user-menu.active {
            display: block;
        }

        /* Style pour la barre de défilement du sidebar */
        .sidebar-container::-webkit-scrollbar {
            width: 4px;
        }

        .sidebar-container::-webkit-scrollbar-track {
            background: transparent;
        }

        .sidebar-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 2px;
        }

        .sidebar-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        /* Bouton menu mobile */
        .mobile-menu-btn {
            display: none;
        }

        @media (max-width: 768px) {
            .mobile-menu-btn {
                display: block;
            }
        }
    </style>
</head>

<body class="flex">
    <!-- BOUTON MENU MOBILE (visible uniquement sur mobile) -->
    <button id="mobileMenuBtn"
        class="mobile-menu-btn fixed top-4 left-4 z-50 bg-indigo-600 text-white p-2 rounded-lg shadow-lg">
        <span class="material-icons">menu</span>
    </button>

    <!-- SIDEBAR FIXE -->
    <aside class="sidebar-container w-64 bg-white shadow-lg p-5 flex flex-col">
        <!-- LOGO -->
        <div class="text-center mb-8 pt-4">
            <h1 class="text-2xl font-bold text-indigo-600">iVote</h1>
            <p class="text-gray-500 text-sm">Système de vote en ligne</p>
        </div>

        <!-- USER PROFILE -->
        <div class="text-center mb-8">
            <div
                class="w-16 h-16 mx-auto rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center border-2 border-indigo-100">
                <span class="text-white font-bold text-xl">
                    <%= user.prenom ? user.prenom.charAt(0).toUpperCase() : '' %>
                        <%= user.nom ? user.nom.charAt(0).toUpperCase() : '' %>
                </span>
            </div>
            <h2 class="mt-3 font-bold">
                <%= user.name %>
            </h2>
            <p class="text-gray-500 text-sm">
                <%= user.email %>
            </p>
            <p class="text-gray-400 text-xs mt-1">Membre depuis <%= user.joinDate %>
            </p>
        </div>

        <!-- MENU -->
        <nav class="flex-1">
            <div class="space-y-1">
                <a href="/dashboard"
                    class="sidebar-btn flex items-center px-4 py-3 rounded-lg <%= page === 'dashboard' ? 'active' : '' %>">
                    <span class="material-icons mr-3">dashboard</span> Dashboard
                </a>

               
                <a href="/vote"
                    class="sidebar-btn flex items-center px-4 py-3 rounded-lg <%= page === 'vote' ? 'active' : '' %>">
                    <span class="material-icons mr-3">how_to_vote</span>
                    Vote / Sondage
                </a>




                <a href="/rooms"
                    class="sidebar-btn flex items-center px-4 py-3 rounded-lg <%= page === 'rooms' ? 'active' : '' %>">
                    <span class="material-icons mr-3">meeting_room</span> Rooms
                </a>

                
                <a href="/network"
                    class="sidebar-btn flex items-center px-4 py-3 rounded-lg <%= page === 'network' ? 'active' : '' %>">
                    <span class="material-icons mr-3">people</span> Network
                </a>

                <!-- Notifications -->
                <a href="/notifications"
                    class="sidebar-btn flex items-center px-4 py-3 rounded-lg <%= page === 'notifications' ? 'active' : '' %>">
                    <span class="material-icons mr-3">notifications</span> Notifications
                    <% if (typeof unreadNotificationCount !=='undefined' && unreadNotificationCount> 0) { %>
                        <span class="ml-2 bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">
                            <%= unreadNotificationCount %>
                        </span>
                        <% } %>
                </a>

                <a href="/statistics"
                    class="sidebar-btn flex items-center px-4 py-3 rounded-lg <%= page === 'statistics' ? 'active' : '' %>">
                    <span class="material-icons mr-3">trending_up</span> Statistiques
                </a>


            </div>
        </nav>

        <!-- LOGOUT -->
        <div class="mt-auto pt-6 border-t">
            <a href="/logout" class="sidebar-btn flex items-center px-4 py-3 rounded-lg text-red-600 hover:bg-red-50">
                <span class="material-icons mr-3">logout</span> Déconnexion
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content p-8">
        <!-- HEADER AVEC RECHERCHE -->
        <header class="mb-8">
            <div class="flex justify-between items-center">
                <div class="flex-1 max-w-2xl">
                    <div class="relative">
                        <span
                            class="material-icons absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">search</span>
                        <input type="text" placeholder="Rechercher des sondages, rooms, utilisateurs..."
                            class="w-full pl-10 pr-4 py-2 bg-white rounded-lg border border-gray-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
                            id="globalSearch">
                    </div>
                </div>

                <div class="flex items-center space-x-4 ml-4">
                    <!-- Bouton Notifications -->
                    <a href="/notifications" class="relative">
                        <span
                            class="material-icons text-gray-600 text-2xl hover:text-indigo-600 transition">notifications</span>
                        <% let unreadCount=0; if (typeof unreadNotificationCount !=='undefined' &&
                            unreadNotificationCount !==null) { unreadCount=parseInt(unreadNotificationCount) || 0; } %>
                            <% if (unreadCount> 0) { %>
                                <span
                                    class="absolute -top-1 -right-1 bg-red-500 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">
                                    <%= unreadCount %>
                                </span>
                                <% } %>
                    </a>

                    <!-- Menu Utilisateur -->
                    <div class="relative">
                        <button id="userMenuButton"
                            class="h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center hover:bg-indigo-200 transition"
                            aria-label="Menu utilisateur">
                            <span class="material-icons text-indigo-600">person</span>
                        </button>

                        <!-- Menu déroulant -->
                        <div id="userMenu" class="user-menu bg-white shadow-lg rounded-lg w-48 mt-2 py-2">
                            <div class="px-4 py-2 border-b">
                                <p class="font-medium text-gray-800">
                                    <%= user.name %>
                                </p>
                                <p class="text-sm text-gray-500 truncate">
                                    <%= user.email %>
                                </p>
                            </div>

                            <!-- Dans le menu utilisateur -->
                            <a href="/profile" class="flex items-center px-4 py-2 text-gray-700 hover:bg-gray-100">
                                <span class="material-icons mr-3 text-sm">person_outline</span>
                                Mon Profil
                            </a>

                            <a href="/profile/edit" class="flex items-center px-4 py-2 text-gray-700 hover:bg-gray-100">
                                <span class="material-icons mr-3 text-sm">edit</span>
                                Modifier Profil
                            </a>



                            <div class="border-t mt-2 pt-2">
                                <a href="/logout" class="flex items-center px-4 py-2 text-red-600 hover:bg-red-50">
                                    <span class="material-icons mr-3 text-sm">logout</span>
                                    Déconnexion
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- CONTENU DE LA PAGE -->
        <%- body %>
    </main>

    <!-- SCRIPTS -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log('Dashboard chargé pour:', '<%= user.name %>');

            // Éléments DOM
            const userMenuButton = document.getElementById('userMenuButton');
            const userMenu = document.getElementById('userMenu');
            const searchInput = document.getElementById('globalSearch');
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const sidebarContainer = document.querySelector('.sidebar-container');

            // Vérification de session
            fetch('/api/auth/status')
                .then(response => response.json())
                .then(data => {
                    if (!data.isAuthenticated) {
                        window.location.href = '/';
                    }
                })
                .catch(error => {
                    console.error('Erreur de vérification:', error);
                });

            // Menu utilisateur (desktop)
            if (userMenuButton && userMenu) {
                userMenuButton.addEventListener('click', (e) => {
                    e.stopPropagation();
                    userMenu.classList.toggle('active');
                });

                // Fermer le menu en cliquant ailleurs
                document.addEventListener('click', (e) => {
                    if (!userMenu.contains(e.target) && !userMenuButton.contains(e.target)) {
                        userMenu.classList.remove('active');
                    }
                });

                // Empêcher la fermeture en cliquant dans le menu
                userMenu.addEventListener('click', (e) => {
                    e.stopPropagation();
                });
            }

            // Recherche globale
            if (searchInput) {
                searchInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        const query = searchInput.value.trim();
                        if (query) {
                            window.location.href = `/search?q=${encodeURIComponent(query)}`;
                        }
                    }
                });
            }

            // Menu mobile
            if (mobileMenuBtn && sidebarContainer) {
                mobileMenuBtn.addEventListener('click', () => {
                    sidebarContainer.classList.toggle('active');
                });

                // Fermer le menu en cliquant en dehors (sur mobile)
                document.addEventListener('click', (e) => {
                    if (window.innerWidth <= 768) {
                        if (!sidebarContainer.contains(e.target) && !mobileMenuBtn.contains(e.target)) {
                            sidebarContainer.classList.remove('active');
                        }
                    }
                });

                // Fermer le menu lors d'un clic sur un lien (sur mobile)
                sidebarContainer.querySelectorAll('a').forEach(link => {
                    link.addEventListener('click', () => {
                        if (window.innerWidth <= 768) {
                            sidebarContainer.classList.remove('active');
                        }
                    });
                });
            }

            // Adapter le sidebar sur le redimensionnement
            window.addEventListener('resize', () => {
                if (window.innerWidth > 768 && sidebarContainer) {
                    sidebarContainer.classList.remove('active');
                }
            });

            // Afficher un message si la variable n'est pas définie (debug)
            if (typeof unreadNotificationCount === 'undefined') {
                console.warn('⚠️ unreadNotificationCount n\'est pas défini dans cette vue');
            }
        });

        // Fonction utilitaire pour les toasts
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300 ${type === 'success' ? 'bg-green-500 text-white' :
                    type === 'error' ? 'bg-red-500 text-white' :
                        'bg-blue-500 text-white'
                }`;
            toast.textContent = message;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                setTimeout(() => {
                    document.body.removeChild(toast);
                }, 300);
            }, 3000);
        }

        // Empêcher le débordement horizontal
        document.body.style.overflowX = 'hidden';
    </script>
</body>

</html>