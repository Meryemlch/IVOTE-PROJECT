        function showCopySuccess(buttonId) {
            const button = document.querySelector(`.copy-link-btn[onclick*="${buttonId}"]`);
            if (button) {
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="material-icons">check</i> Copié!';
                button.classList.add('copied');
                
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.classList.remove('copied');
                }, 2000);
            }
        }

        function shareOnFacebook(link, title) {
            const url = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(link)}&quote=${title}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('facebook');
        }

        function shareOnTwitter(link, title) {
            const url = `https://twitter.com/intent/tweet?url=${encodeURIComponent(link)}&text=${title}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('twitter');
        }

        function shareOnWhatsApp(link, title) {
            const url = `https://wa.me/?text=${encodeURIComponent(title + ' ' + link)}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('whatsapp');
        }

        function shareOnLinkedIn(link, title, description) {
            const url = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(link)}&title=${title}&summary=${description}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('linkedin');
        }

        function shareByEmail(link, title) {
            const url = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent('Regarde ce sondage intéressant: ' + link)}`;
            window.location.href = url;
            trackShare('email');
        }

        async function trackShare(platform) {
            try {
                await fetch(`/api/polls/${currentSharePollId}/share`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        share_platform: platform,
                        share_message: `Partagé sur ${platform}`
                    })
                });
                
                await loadPolls();
            } catch (error) {
                console.error('Erreur de suivi du partage:', error);
            }
        }

