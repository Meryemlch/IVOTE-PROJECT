        function copyPollLink(event) {
    event.preventDefault(); // Empêcher le comportement par défaut
    
    const input = document.getElementById('pollLinkInput');
    
    // Sélectionner le texte
    input.select();
    input.setSelectionRange(0, 99999); // Pour les mobiles
    
    try {
        // Utiliser l'API Clipboard moderne
        navigator.clipboard.writeText(input.value).then(() => {
            // Afficher un feedback visuel
            const button = event.target.closest('.copy-link-btn');
            if (button) {
                const originalText = button.innerHTML;
                const originalClass = button.className;
                
                button.innerHTML = '<i class="material-icons">check</i> Copié!';
                button.className = 'copy-link-btn copied';
                
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.className = originalClass;
                }, 2000);
            }
            
            // Afficher une notification
            showSuccess('Lien copié dans le presse-papier!');
        }).catch(err => {
            // Fallback pour les anciens navigateurs
            document.execCommand('copy');
            
            // Afficher un feedback visuel même avec le fallback
            const button = event.target.closest('.copy-link-btn');
            if (button) {
                const originalText = button.innerHTML;
                const originalClass = button.className;
                
                button.innerHTML = '<i class="material-icons">check</i> Copié!';
                button.className = 'copy-link-btn copied';
                
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.className = originalClass;
                }, 2000);
            }
            
            showSuccess('Lien copié dans le presse-papier!');
        });
    } catch (error) {
        // Fallback pour les navigateurs très anciens
        try {
            document.execCommand('copy');
            showSuccess('Lien copié dans le presse-papier!');
        } catch (err) {
            showError('Impossible de copier le lien. Veuillez le sélectionner manuellement.');
        }
    }
}

