            </div>
        </div>

        <!-- Modal pour voir toutes les options -->
        <div id="optionsModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center p-4 modal-options">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto">
                <div class="p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-2xl font-bold text-gray-800" id="optionsModalTitle"></h3>
                        <button onclick="closeOptionsModal()" class="text-gray-400 hover:text-gray-600">
                            <span class="material-icons text-2xl">close</span>
                        </button>
                    </div>
                    
                    <div class="mb-6 p-4 bg-blue-50 rounded-lg">
                        <div class="flex flex-wrap gap-4 text-sm">
                            <span class="flex items-center">
                                <span class="material-icons text-base mr-1">description</span>
                                <span id="optionsModalQuestion"></span>
                            </span>
                            <span class="flex items-center">
                                <span class="material-icons text-base mr-1">list</span>
                                <span id="optionsCount">0</span> options au total
                            </span>
                        </div>
                    </div>
                    
                    <div id="allOptionsContainer" class="options-grid"></div>
                    
                    <div class="flex justify-end pt-6 border-t">
                        <button onclick="closeOptionsModal()" 
                                class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                            Fermer
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ==================== MODALS DU SYSTÈME DE COMMENTAIRES ET RÉACTIONS ==================== -->
        
        <!-- Modal pour les commentaires -->
        <div id="commentsModal" class="modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h2>
                        <i class="material-icons">comment</i>
                        Commentaires
                    </h2>
                    <button class="close-modal">
                        <i class="material-icons">close</i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="comments-container" id="commentsContainer">
                        <!-- Les commentaires seront chargés ici -->
                    </div>
                    <div class="add-comment-section">
                        <textarea id="commentInput" placeholder="Ajouter un commentaire..." rows="3"></textarea>
                        <button id="submitComment" class="btn-primary">
                            <i class="material-icons">send</i>
                            Publier
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal pour les réactions -->
        <div id="reactionsModal" class="modal">
            <div class="modal-content reactions-modal">
                <div class="modal-header">
                    <h2>
                        <i class="material-icons">emoji_emotions</i>
                        Réagir
                    </h2>
                    <button class="close-modal">
                        <i class="material-icons">close</i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="reactions-grid" id="reactionsGrid">
                        <!-- Les réactions seront chargées ici dynamiquement -->
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal pour le partage -->
        <div id="shareModal" class="modal">
            <div class="modal-content share-modal">
                <div class="modal-header">
                    <h2>
                        <i class="material-icons">share</i>
                        Partager
                    </h2>
                    <button class="close-modal">
                        <i class="material-icons">close</i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="share-options" id="shareOptions">
                        <!-- Les options de partage seront chargées ici -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        // Initialiser AOS
        AOS.init({
            duration: 800,
            once: true,
            offset: 100
        });

        // Variables globales
        let currentPollId = null;
        let currentManagePollId = null;
        let allPolls = [];
        let filteredPolls = [];
        let currentTab = 'all';
        let optionCounter = 1;
        let currentImages = {};
        let categories = [];
        let confirmActionCallback = null;
        let confirmActionType = null;
        
        // Variables du système de commentaires et réactions
        let currentReactionPollId = null;
        let currentSharePollId = null;
        let activeReactionPreview = null;
        let hidePreviewTimeout = null;
        
        // Pagination variables
        let currentPage = 1;
        const pollsPerPage = 2; // 2 sondages par page
        let totalPages = 1;
        
        // Options modal variables
        let currentOptionsPoll = null;

        // Constantes pour les réactions
        const REACTIONS = [
            { type: 'like', emoji: '👍', name: 'J\'aime' },
            { type: 'love', emoji: '❤️', name: 'J\'adore' },
            { type: 'wow', emoji: '😮', name: 'Wow' },
            { type: 'haha', emoji: '😄', name: 'Haha' },
            { type: 'sad', emoji: '😢', name: 'Triste' },
            { type: 'angry', emoji: '😠', name: 'En colère' }
        ];

        // Initialisation
        document.addEventListener('DOMContentLoaded', async () => {
            await loadCategories();
            await loadPolls();
            initializeCreateForm();
            
            // Écouteurs d'événements pour les filtres
            document.getElementById('searchInput').addEventListener('input', () => filterPolls(currentTab));
            document.getElementById('categoryFilter').addEventListener('change', () => filterPolls(currentTab));
            document.getElementById('statusFilter').addEventListener('change', () => filterPolls(currentTab));
            
            // Initialiser les écouteurs d'événements pour le système de commentaires
            setupEventListeners();
        });

        async function loadCategories() {
            try {
                const response = await fetch('/api/categories');
                const data = await response.json();
                
                if (data.success) {
                    categories = data.categories;
                    const categorySelect = document.querySelector('select[name="category_id"]');
                    const categoryFilter = document.getElementById('categoryFilter');
                    const editCategory = document.getElementById('editCategory');
                    
                    // Ajouter option vide
                    categorySelect.innerHTML = '<option value="">Sélectionner une catégorie</option>';
                    categoryFilter.innerHTML = '<option value="">Toutes catégories</option>';
                    editCategory.innerHTML = '<option value="">Sélectionner une catégorie</option>';
                    
                    categories.forEach(category => {
                        const option = document.createElement('option');
                        option.value = category.id;
                        option.textContent = category.name;
                        categorySelect.appendChild(option.cloneNode(true));
                        categoryFilter.appendChild(option.cloneNode(true));
                        editCategory.appendChild(option.cloneNode(true));
                    });
                }
            } catch (error) {
                console.error('Erreur lors du chargement des catégories:', error);
            }
        }

        async function loadPolls() {
            try {
                const response = await fetch('/api/explorer/polls');
                const data = await response.json();
                
                if (data.success) {
                    allPolls = data.polls;
                    updateStats(allPolls);
                    filterPolls(currentTab);
                } else {
                    showMessage('error', 'Erreur lors du chargement des sondages');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showMessage('error', 'Erreur de connexion au serveur');
            }
        }

        function updateStats(polls) {
            const total = polls.length;
            const active = polls.filter(p => p.is_active === 1).length;
            const sondages = polls.filter(p => p.poll_category === 'sondage').length;
            const participations = polls.filter(p => p.has_voted).length;
            
            document.getElementById('totalCount').textContent = total;
            document.getElementById('activeCount').textContent = active;
            document.getElementById('pollCount').textContent = sondages;
            document.getElementById('participationsCount').textContent = participations;
        }

        function filterPolls(tab) {
            currentTab = tab;
            
            // Mettre à jour les tabs
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('tab-active');
                if (btn.dataset.tab === tab) {
                    btn.classList.add('tab-active');
                }
            });
            
            filteredPolls = allPolls;
            
            switch(tab) {
                case 'votes':
                    filteredPolls = allPolls.filter(p => p.poll_category === 'vote');
                    break;
                case 'sondages':
                    filteredPolls = allPolls.filter(p => p.poll_category === 'sondage');
                    break;
                case 'my-creations':
                    filteredPolls = allPolls.filter(p => p.is_creator);
                    break;
                case 'others-creations':
                    filteredPolls = allPolls.filter(p => !p.is_creator);
                    break;
                case 'participated':
                    filteredPolls = allPolls.filter(p => p.has_voted);
                    break;
                case 'all':
                default:
                    filteredPolls = allPolls;
            }
            
            // Appliquer les filtres supplémentaires
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const categoryFilter = document.getElementById('categoryFilter').value;
            const statusFilter = document.getElementById('statusFilter').value;
            
            if (searchTerm) {
                filteredPolls = filteredPolls.filter(poll => 
                    poll.title.toLowerCase().includes(searchTerm) ||
                    poll.question.toLowerCase().includes(searchTerm) ||
                    poll.creator_name.toLowerCase().includes(searchTerm)
                );
            }
            
            if (categoryFilter) {
                filteredPolls = filteredPolls.filter(poll => poll.category_id == categoryFilter);
            }
            
            if (statusFilter !== 'all') {
                if (statusFilter === 'active') {
                    filteredPolls = filteredPolls.filter(poll => poll.is_active === 1);
                } else if (statusFilter === 'closed') {
                    filteredPolls = filteredPolls.filter(poll => poll.is_active === 0);
                }
            }
            
            // Réinitialiser la pagination
            currentPage = 1;
            displayPolls();
        }

        function filterByType(type) {
            document.querySelectorAll('.filter-type-btn').forEach(btn => {
                btn.classList.remove('active');
                if (btn.textContent.trim().includes(type === 'all' ? 'Tous' : 
                    type === 'sondage' ? 'Sondages' : 'Votes')) {
                    btn.classList.add('active');
                }
            });
            
            filteredPolls = allPolls;
            
            if (type !== 'all') {
                filteredPolls = allPolls.filter(p => p.poll_category === type);
            }
            
            // Garder le filtre de tab actif
            switch(currentTab) {
                case 'votes':
                    filteredPolls = filteredPolls.filter(p => p.poll_category === 'vote');
                    break;
                case 'sondages':
                    filteredPolls = filteredPolls.filter(p => p.poll_category === 'sondage');
                    break;
                case 'my-creations':
                    filteredPolls = filteredPolls.filter(p => p.is_creator);
                    break;
                case 'others-creations':
                    filteredPolls = filteredPolls.filter(p => !p.is_creator);
                    break;
                case 'participated':
                    filteredPolls = filteredPolls.filter(p => p.has_voted);
                    break;
            }
            
            // Réinitialiser la pagination
            currentPage = 1;
            displayPolls();
        }

        function switchTab(tab) {
            filterPolls(tab);
        }

        function displayPolls() {
            const container = document.getElementById('pollsContainer');
            const paginationContainer = document.getElementById('paginationContainer');
            
            if (filteredPolls.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <span class="material-icons text-gray-400 text-6xl mb-4">info</span>
                        <h3 class="text-xl font-semibold text-gray-700 mb-2">Aucun contenu disponible</h3>
                        <p class="text-gray-500">Créez votre premier sondage ou vote, ou revenez plus tard.</p>
                    </div>
                `;
                paginationContainer.classList.add('hidden');
                return;
            }

            // Calculer les indices de début et fin pour la page actuelle
            const startIndex = (currentPage - 1) * pollsPerPage;
            const endIndex = Math.min(startIndex + pollsPerPage, filteredPolls.length);
            const pollsToDisplay = filteredPolls.slice(startIndex, endIndex);
            
            // Calculer le nombre total de pages
            totalPages = Math.ceil(filteredPolls.length / pollsPerPage);
            
            // Afficher les sondages
            container.innerHTML = `
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    ${pollsToDisplay.map(poll => createPollCard(poll)).join('')}
                </div>
            `;

            // Mettre à jour la pagination
            updatePagination();
            
            // Afficher la pagination s'il y a plus d'une page
            if (totalPages > 1) {
                paginationContainer.classList.remove('hidden');
            } else {
                paginationContainer.classList.add('hidden');
            }
        }

        function updatePagination() {
            const displayStart = document.getElementById('displayStart');
            const displayEnd = document.getElementById('displayEnd');
            const totalDisplayCount = document.getElementById('totalDisplayCount');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const pageNumbers = document.getElementById('pageNumbers');
            
            // Mettre à jour les informations de pagination
            const startIndex = (currentPage - 1) * pollsPerPage + 1;
            const endIndex = Math.min(currentPage * pollsPerPage, filteredPolls.length);
            
            displayStart.textContent = startIndex;
            displayEnd.textContent = endIndex;
            totalDisplayCount.textContent = filteredPolls.length;
            
            // Activer/désactiver les boutons précédent/suivant
            prevBtn.disabled = currentPage === 1;
            nextBtn.disabled = currentPage === totalPages;
            
            // Générer les numéros de page
            pageNumbers.innerHTML = '';
            
            // Toujours afficher la première page
            addPageNumber(1);
            
            // Afficher les points de suspension si nécessaire
            if (currentPage > 3) {
                addEllipsis();
            }
            
            // Afficher les pages autour de la page actuelle
            for (let i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                if (i !== 1 && i !== totalPages) {
                    addPageNumber(i);
                }
            }
            
            // Afficher les points de suspension si nécessaire
            if (currentPage < totalPages - 2) {
                addEllipsis();
            }
            
            // Toujours afficher la dernière page si elle existe
            if (totalPages > 1) {
                addPageNumber(totalPages);
            }
        }

        function addPageNumber(pageNumber) {
            const pageNumbers = document.getElementById('pageNumbers');
            const pageElement = document.createElement('button');
            pageElement.className = `page-number ${pageNumber === currentPage ? 'active' : ''}`;
            pageElement.textContent = pageNumber;
            pageElement.onclick = () => goToPage(pageNumber);
            pageNumbers.appendChild(pageElement);
        }

        function addEllipsis() {
            const pageNumbers = document.getElementById('pageNumbers');
            const ellipsis = document.createElement('span');
            ellipsis.className = 'page-ellipsis';
            ellipsis.textContent = '...';
            pageNumbers.appendChild(ellipsis);
        }

        function goToPage(page) {
            if (page < 1 || page > totalPages) return;
            
            currentPage = page;
            displayPolls();
            
            // Scroll vers le haut de la liste
            document.getElementById('pollsContainer').scrollIntoView({ behavior: 'smooth' });
        }

        function createPollCard(poll) {
            const isCreator = poll.is_creator === 1;
            const isActive = poll.is_active === 1;
            const hasVoted = poll.has_voted;
            const canVote = isActive && !hasVoted && !isCreator;
            
            // Calculer les réactions regroupées
            const reactionsByType = {};
            if (poll.reactions && Array.isArray(poll.reactions)) {
                poll.reactions.forEach(reaction => {
                    if (!reactionsByType[reaction.reaction_type]) {
                        reactionsByType[reaction.reaction_type] = {
                            count: 0,
                            users: []
                        };
                    }
                    reactionsByType[reaction.reaction_type].count += reaction.count;
                });
            }
            
            const totalReactions = Object.values(reactionsByType).reduce((sum, r) => sum + r.count, 0);
            const userReactionType = poll.user_reaction;
            
            const now = new Date();
            const endTime = new Date(poll.end_time);
            const timeLeft = getTimeLeft(endTime);
            
            // Badge de type avec dégradé
            const typeBadge = poll.poll_category === 'sondage' ? 
                '<span class="type-badge inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-sm">Sondage</span>' :
                '<span class="type-badge inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-purple-500 to-purple-600 text-white shadow-sm">Vote</span>';
            
            // Badge de statut avec animation
            const statusBadge = isActive ? 
                `<div class="flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-green-50 to-emerald-50 border border-green-200 rounded-full">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                    </span>
                    <span class="text-sm font-medium text-green-700">${timeLeft}</span>
                </div>` :
                `<div class="px-4 py-2 bg-gradient-to-r from-gray-50 to-slate-50 border border-gray-200 rounded-full">
                    <span class="text-sm font-medium text-gray-600">Terminé</span>
                </div>`;
            
            // Badge de catégorie avec style amélioré
            const categoryClass = poll.category_name ? 
                `category-${poll.category_name.toLowerCase().replace(/[^a-z]/g, '')}` : 'category-sondage';
            const categoryBadge = poll.category_name ? 
                `<span class="category-badge inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-white border border-gray-200 text-gray-700 shadow-sm ${categoryClass}">
                    <span class="material-icons text-xs mr-1">label</span>${poll.category_name}
                </span>` : '';
            
            // Badge propriétaire avec gradient doré
            const ownerBadge = poll.is_creator ? 
                `<span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-amber-400 to-yellow-500 text-white shadow-sm">
                    <span class="material-icons text-xs mr-1">stars</span>Propriétaire
                </span>` : '';
            
            // Bouton d'action avec styles améliorés
            let actionButton = '';
            if (poll.is_creator) {
                actionButton = `
                    <button onclick="openManageModal(${poll.id})" 
                            class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-lg font-medium shadow-md hover:shadow-lg hover:from-amber-600 hover:to-orange-600 transition-all duration-200 transform hover:scale-105">
                        <span class="material-icons text-sm mr-2">settings</span>
                        Gérer
                    </button>
                `;
            } else if (isActive) {
                actionButton = hasVoted ? 
                    `<button class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-gray-100 to-gray-200 text-gray-600 rounded-lg font-medium cursor-default shadow-sm">
                        <span class="material-icons text-sm mr-2">check_circle</span>
                        Déjà voté
                    </button>` :
                    `<button onclick="openVoteModal(${poll.id})" 
                            class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-blue-500 to-indigo-600 text-white rounded-lg font-medium shadow-md hover:shadow-lg hover:from-blue-600 hover:to-indigo-700 transition-all duration-200 transform hover:scale-105">
                        <span class="material-icons text-sm mr-2">how_to_vote</span>
                        Participer
                    </button>`;
            } else {
                actionButton = `
                    <button onclick="openResultsModal(${poll.id})" 
                            class="inline-flex items-center px-5 py-2.5 bg-gradient-to-r from-purple-500 to-pink-600 text-white rounded-lg font-medium shadow-md hover:shadow-lg hover:from-purple-600 hover:to-pink-700 transition-all duration-200 transform hover:scale-105">
                        <span class="material-icons text-sm mr-2">bar_chart</span>
                        Voir résultats
                    </button>
                `;
            }
            
            // Avertissement créateur avec meilleur style
            const creatorWarning = poll.is_creator && poll.poll_category === 'vote' ? 
                `<div class="mt-4 flex items-start gap-3 p-4 bg-gradient-to-r from-amber-50 to-yellow-50 border border-amber-200 rounded-xl">
                    <span class="material-icons text-amber-600 mt-0.5">info</span>
                    <p class="text-sm text-amber-800 leading-relaxed">
                        En tant que créateur d'un vote officiel, vous ne pouvez pas participer.
                    </p>
                </div>` : '';
            
            // Limiter à 3 options affichées
            const optionsToShow = poll.options.slice(0, 3);
            const remainingOptions = poll.options.length - 3;
            
            return `
                <div class="poll-card group bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 overflow-hidden border ${isActive ? 'border-blue-200' : 'border-gray-200'}">
                    ${isActive ? '<div class="h-1 bg-gradient-to-r from-blue-500 via-indigo-500 to-purple-500"></div>' : '<div class="h-1 bg-gradient-to-r from-gray-300 to-gray-400"></div>'}
                    
                    <div class="p-6">
                        <div class="flex justify-between items-start mb-5">
                            <div class="flex-1">
                                <div class="flex flex-wrap items-center gap-2 mb-3">
                                    ${typeBadge}
                                    ${categoryBadge}
                                    ${ownerBadge}
                                </div>
                                <h3 class="text-2xl font-bold text-gray-900 mb-2 leading-tight group-hover:text-blue-600 transition-colors">
                                    ${escapeHtml(poll.title)}
                                </h3>
                                <p class="text-gray-600 mb-4 leading-relaxed">${escapeHtml(poll.question)}</p>
                                
                                <div class="flex flex-wrap items-center gap-4 text-sm text-gray-500">
                                    <span class="inline-flex items-center gap-1.5 bg-gray-50 px-3 py-1.5 rounded-lg">
                                        <span class="material-icons text-base">person</span>
                                        <span class="font-medium">${escapeHtml(poll.creator_name)}</span>
                                    </span>
                                    <span class="inline-flex items-center gap-1.5 bg-gray-50 px-3 py-1.5 rounded-lg">
                                        <span class="material-icons text-base">schedule</span>
                                        ${formatDate(poll.created_at)}
                                    </span>
                                    <span class="inline-flex items-center gap-1.5 bg-gradient-to-r from-blue-50 to-indigo-50 px-3 py-1.5 rounded-lg">
                                        <span class="material-icons text-base text-blue-600">group</span>
                                        <span class="font-medium text-blue-700">${poll.total_votes || 0} participants</span>
                                    </span>
                                </div>
                            </div>
                            ${statusBadge}
                        </div>
                        
                        ${poll.description ? `
                            <div class="mb-5 p-4 bg-gradient-to-br from-gray-50 to-slate-50 rounded-xl border border-gray-100">
                                <p class="text-sm text-gray-700 leading-relaxed italic">${escapeHtml(poll.description)}</p>
                            </div>
                        ` : ''}
                        
                        <div class="mb-5">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-sm font-semibold text-gray-700 flex items-center gap-2">
                                    <span class="material-icons text-base text-blue-600">ballot</span>
                                    Options disponibles
                                </span>
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-medium">
                                    <span class="material-icons text-xs">${poll.poll_type === 'single' ? 'radio_button_checked' : 'check_box'}</span>
                                    ${poll.poll_type === 'single' ? 'Choix unique' : 'Choix multiple'}
                                </span>
                            </div>
                            <div class="space-y-2.5">
                                ${optionsToShow.map((option, index) => `
                                    <div class="flex items-center p-3.5 bg-gradient-to-r from-gray-50 to-slate-50 hover:from-blue-50 hover:to-indigo-50 rounded-xl border border-gray-100 hover:border-blue-200 transition-all duration-200 group/option">
                                        ${option.option_image ? 
                                            `<img src="${option.option_image}" alt="${escapeHtml(option.option_text)}" 
                                                  class="w-14 h-14 object-cover rounded-lg mr-3 shadow-sm border border-gray-200 group-hover/option:scale-105 transition-transform">` : 
                                            `<div class="w-14 h-14 bg-gradient-to-br from-blue-100 to-indigo-100 rounded-lg flex items-center justify-center mr-3 shadow-sm group-hover/option:scale-105 transition-transform">
                                                <span class="material-icons text-blue-600">description</span>
                                            </div>`
                                        }
                                        <span class="flex-1 text-gray-800 font-medium">${escapeHtml(option.option_text)}</span>
