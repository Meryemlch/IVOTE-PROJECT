    </div>

    <!-- Contenu principal (deuxième code inchangé) -->
    <div class="explorer-container">
        <!-- Liste des sondages/votes -->
        <div id="pollsList" class="polls-list">
            <!-- Le contenu sera chargé dynamiquement -->
            <div class="loading">
                <div class="spinner"></div>
                <p>Chargement des sondages...</p>
            </div>
        </div>
        
        <!-- Indicateur de chargement -->
        <div id="loadingMore" class="loading-more" style="display: none;">
            <div class="spinner"></div>
            <p>Chargement...</p>
        </div>
        
        <!-- Indicateur de fin -->
        <div id="endOfContent" class="end-of-content" style="display: none;">
            <p>Vous avez vu tous les sondages</p>
        </div>
    </div>

    <!-- Modal pour les commentaires -->
    <div id="commentsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>
                    <i class="material-icons">comment</i>
                    Commentaires
                </h2>
                <button class="close-modal">
                    <i class="material-icons">close</i>
                </button>
            </div>
            <div class="modal-body">
                <div class="comments-container" id="commentsContainer">
                    <!-- Les commentaires seront chargés ici -->
                </div>
                <div class="add-comment-section">
                    <textarea id="commentInput" placeholder="Ajouter un commentaire..." rows="3"></textarea>
                    <button id="submitComment" class="btn-primary">
                        <i class="material-icons">send</i>
                        Publier
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour les résultats -->
    <div id="resultsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>
                    <i class="material-icons">bar_chart</i>
                    Résultats
                </h2>
                <button class="close-modal">
                    <i class="material-icons">close</i>
                </button>
            </div>
            <div class="modal-body">
                <div id="resultsContainer">
                    <!-- Les résultats seront chargés ici -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour les réactions -->
    <div id="reactionsModal" class="modal">
        <div class="modal-content reactions-modal">
            <div class="modal-header">
                <h2>
                    <i class="material-icons">emoji_emotions</i>
                    Réagir
                </h2>
                <button class="close-modal">
                    <i class="material-icons">close</i>
                </button>
            </div>
            <div class="modal-body">
                <div class="reactions-grid" id="reactionsGrid">
                    <!-- Les réactions seront chargées ici dynamiquement -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal pour le partage -->
    <div id="shareModal" class="modal">
        <div class="modal-content share-modal">
            <div class="modal-header">
                <h2>
                    <i class="material-icons">share</i>
                    Partager
                </h2>
                <button class="close-modal">
                    <i class="material-icons">close</i>
                </button>
            </div>
            <div class="modal-body">
                <div class="share-options" id="shareOptions">
                    <!-- Les options de partage seront chargées ici -->
                </div>
            </div>
        </div>
    </div>

    <!-- Script AOS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    
    <script>
        // Variables globales pour le header
        let currentFilter = 'all';
        
        document.addEventListener('DOMContentLoaded', function() {
            // Initialiser AOS
            AOS.init({
                duration: 800,
                once: true,
                offset: 100
            });
            
            // Créer les particules flottantes
            createFloatingParticles();
            
            // Initialiser les écouteurs d'événements pour le header
            setupHeaderEventListeners();
            
            // Charger le nombre de sondages actifs
            loadActivePollsCount();
            
            // Charger les sondages (code original)
            loadPolls();
            setupEventListeners();
        });

        // Fonctions du header décoré
        function createFloatingParticles() {
            const container = document.getElementById('particles');
            if (!container) return;
            
            for (let i = 0; i < 15; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                
                // Taille aléatoire
                const size = Math.random() * 10 + 5;
                particle.style.width = `${size}px`;
                particle.style.height = `${size}px`;
                
                // Position aléatoire
                particle.style.left = `${Math.random() * 100}%`;
                particle.style.top = `${Math.random() * 100}%`;
                
                // Animation delay
                particle.style.animationDelay = `${Math.random() * 15}s`;
                
                container.appendChild(particle);
            }
        }

        function setupHeaderEventListeners() {
            // Gestion des filtres avec animations
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    // Retirer la classe active de tous les boutons
                    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                    
                    // Ajouter la classe active au bouton cliqué
                    this.classList.add('active');
                    
                    // Mettre à jour le filtre courant
                    currentFilter = this.dataset.filter;
                    
                    // Déclencher un événement personnalisé pour informer d'autres composants
                    const filterEvent = new CustomEvent('filterChanged', {
                        detail: { filter: currentFilter }
                    });
                    document.dispatchEvent(filterEvent);
                    
                    // Animation du bouton cliqué
                    this.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        this.style.transform = 'translateY(-2px)';
                    }, 150);
                });
            });
        }

        async function loadActivePollsCount() {
            try {
                // Simuler un appel API (à remplacer par votre vraie API)
                // const response = await fetch('/api/explorer/active-polls-count');
                // const data = await response.json();
                
                // Pour la démonstration, utiliser une valeur fixe
                const mockData = {
                    success: true,
                    count: 42
                };
                
                if (mockData.success) {
                    document.getElementById('totalPollsCount').textContent = mockData.count;
                    
                    // Animation du compteur
                    animateCounter('totalPollsCount', 0, mockData.count, 1000);
                }
            } catch (error) {
                console.error('Erreur lors du chargement du compteur:', error);
                document.getElementById('totalPollsCount').textContent = '0';
            }
        }

        function animateCounter(elementId, start, end, duration) {
            const element = document.getElementById(elementId);
            if (!element) return;
            
            let startTimestamp = null;
            const step = (timestamp) => {
                if (!startTimestamp) startTimestamp = timestamp;
                const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                const value = Math.floor(progress * (end - start) + start);
                element.textContent = value;
                if (progress < 1) {
                    window.requestAnimationFrame(step);
                }
            };
            window.requestAnimationFrame(step);
        }

        // Variables globales du code original
        let allPolls = [];
        let filteredPolls = [];
        let currentPollId = null;
        let currentReactionPollId = null;
        let currentSharePollId = null;
        let activeReactionPreview = null;
        let hidePreviewTimeout = null;
        let currentIndex = 0;
        let isLoading = false;
        let hasMore = true;
        let observer = null;
        let pollObservers = [];

        const REACTIONS = [
            { type: 'like', emoji: '👍', name: 'J\'aime' },
            { type: 'love', emoji: '❤️', name: 'J\'adore' },
            { type: 'wow', emoji: '😮', name: 'Wow' },
            { type: 'haha', emoji: '😄', name: 'Haha' },
            { type: 'sad', emoji: '😢', name: 'Triste' },
            { type: 'angry', emoji: '😠', name: 'En colère' }
        ];

        function setupEventListeners() {
            // Fermer les modals
            document.querySelectorAll('.close-modal').forEach(btn => {
                btn.addEventListener('click', function() {
                    this.closest('.modal').classList.remove('active');
                });
            });

            // Cliquer en dehors du modal
            document.querySelectorAll('.modal').forEach(modal => {
                modal.addEventListener('click', function(e) {
                    if (e.target === this) {
                        this.classList.remove('active');
                    }
                });
            });

            // Soumettre un commentaire
            document.getElementById('submitComment').addEventListener('click', submitComment);
            
            document.getElementById('commentInput').addEventListener('keydown', function(e) {
                if (e.ctrlKey && e.key === 'Enter') {
                    submitComment();
                }
            });

            // Fermer la prévisualisation des réactions en cliquant ailleurs
            document.addEventListener('click', function(e) {
                if (activeReactionPreview && !e.target.closest('.reaction-btn-wrapper')) {
                    hideReactionPreview();
                }
            });

            // Empêcher la fermeture quand on survole la prévisualisation
            document.addEventListener('mouseover', function(e) {
                if (activeReactionPreview && e.target.closest('.reaction-preview')) {
                    clearTimeout(hidePreviewTimeout);
                }
            });
        }

        async function loadPolls() {
            try {
                showLoading(true);
                const response = await fetch('/api/explorer/polls');
                const data = await response.json();

                if (data.success) {
                    allPolls = data.polls;
                    filterPolls();
                } else {
                    showError('Erreur lors du chargement des sondages');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showError('Erreur de connexion au serveur');
            } finally {
                showLoading(false);
            }
        }

        function filterPolls() {
            filteredPolls = allPolls;

            if (currentFilter === 'sondage') {
                filteredPolls = allPolls.filter(p => p.poll_category === 'sondage');
            } else if (currentFilter === 'vote') {
                filteredPolls = allPolls.filter(p => p.poll_category === 'vote');
            } else if (currentFilter === 'active') {
                filteredPolls = allPolls.filter(p => p.is_active === 1);
            } else if (currentFilter === 'closed') {
                filteredPolls = allPolls.filter(p => p.is_active === 0);
            }

            // Réinitialiser
            currentIndex = 0;
            hasMore = filteredPolls.length > 0;
            
            // Vider la liste
            const container = document.getElementById('pollsList');
            container.innerHTML = '';
            
            // Cacher les indicateurs
            document.getElementById('endOfContent').style.display = 'none';
            document.getElementById('loadingMore').style.display = 'none';
            
            // Détruire les anciens observers
            pollObservers.forEach(observer => observer.disconnect());
            pollObservers = [];
            
            if (filteredPolls.length === 0) {
                showEmptyState();
            } else {
                // Charger les 2 premiers sondages immédiatement
                loadNextPoll();
                loadNextPoll();
            }
        }

        function loadNextPoll() {
            if (isLoading || !hasMore) return;
            
            if (currentIndex >= filteredPolls.length) {
                hasMore = false;
                showEndOfContent();
                return;
            }
            
            const poll = filteredPolls[currentIndex];
            currentIndex++;
            
            addPollWithObserver(poll);
            
            // Si on est près de la fin, précharger le suivant
            if (currentIndex < filteredPolls.length && currentIndex % 3 === 0) {
                setTimeout(() => loadNextPoll(), 300);
            }
        }

        function addPollWithObserver(poll) {
            const container = document.getElementById('pollsList');
            
            // Créer le poll card mais le cacher initialement
            const pollCard = createPollCard(poll);
            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = pollCard;
            const pollElement = tempDiv.firstElementChild;
            
            // Ajouter au container
            container.appendChild(pollElement);
            
            // Créer un IntersectionObserver pour ce poll spécifique
            const pollObserver = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        // Quand le poll devient visible, l'afficher avec animation
                        setTimeout(() => {
                            pollElement.classList.add('visible');
                            
                            // Attacher les événements après l'animation
                            setTimeout(() => {
                                attachPollEvents(poll.id, poll);
                            }, 300);
                            
                            // Charger le prochain poll quand celui-ci devient visible
                            if (currentIndex < filteredPolls.length) {
                                setTimeout(() => loadNextPoll(), 500);
                            }
                        }, 200);
                        
                        // Une fois affiché, arrêter d'observer ce poll
                        pollObserver.unobserve(pollElement);
                    }
                });
            }, {
                root: null,
                rootMargin: '100px',
                threshold: 0.1
            });
            
            // Observer ce poll
            pollObserver.observe(pollElement);
            pollObservers.push(pollObserver);
        }

        function showEmptyState() {
            const container = document.getElementById('pollsList');
            container.innerHTML = `
                <div class="empty-state">
                    <i class="material-icons">inbox</i>
                    <h3>Aucun sondage trouvé</h3>
                    <p>Changez les filtres pour voir plus de contenu</p>
                </div>
            `;
        }

        function showLoading(show) {
            const container = document.getElementById('pollsList');
            if (show) {
                container.innerHTML = '<div class="loading"><div class="spinner"></div><p>Chargement des sondages...</p></div>';
            }
        }

        function showEndOfContent() {
            if (filteredPolls.length > 0) {
                const endOfContent = document.getElementById('endOfContent');
                endOfContent.style.display = 'block';
            }
        }

        function createPollCard(poll) {
            const isCreator = poll.is_creator === 1;
            const isActive = poll.is_active === 1;
            const hasVoted = poll.has_voted;
            const canVote = isActive && !hasVoted && !isCreator;
            
            // Calculer les réactions regroupées
            const reactionsByType = {};
            if (poll.reactions && Array.isArray(poll.reactions)) {
                poll.reactions.forEach(reaction => {
                    if (!reactionsByType[reaction.reaction_type]) {
                        reactionsByType[reaction.reaction_type] = {
                            count: 0,
                            users: []
                        };
                    }
                    reactionsByType[reaction.reaction_type].count += reaction.count;
                    if (reaction.user_names && Array.isArray(reaction.user_names)) {
                        reactionsByType[reaction.reaction_type].users.push(...reaction.user_names);
                    }
                });
            }
            
            const totalReactions = Object.values(reactionsByType).reduce((sum, r) => sum + r.count, 0);
            const userReactionType = poll.user_reaction;

            return `
                <div class="poll-card" data-poll-id="${poll.id}">
                    <div class="poll-header">
                        <div class="poll-meta">
                            <div class="poll-author">
                                <div class="author-avatar">
                                    ${poll.creator_name.charAt(0).toUpperCase()}
                                </div>
                                <div class="author-info">
                                    <h3>${escapeHtml(poll.creator_name)}</h3>
                                    <span>${formatDate(poll.created_at)}</span>
                                </div>
                            </div>
                            <div class="poll-category ${poll.poll_category}">
                                <i class="material-icons">${poll.poll_category === 'vote' ? 'how_to_vote' : 'poll'}</i>
                                ${poll.poll_category === 'vote' ? 'Vote officiel' : 'Sondage'}
                            </div>
                        </div>
                        
                        <h2 class="poll-title">${escapeHtml(poll.title || poll.question)}</h2>
                        ${poll.description ? `<p class="poll-question">${escapeHtml(poll.description)}</p>` : ''}
                        
                        <div class="poll-status">
                            <span class="status-badge ${isActive ? 'active' : 'closed'}">
                                <i class="material-icons">${isActive ? 'timer' : 'check_circle'}</i>
                                ${isActive ? 'En cours' : 'Terminé'}
                            </span>
                            ${isActive ? `
                                <span class="time-remaining" data-end-time="${poll.end_time}">
                                    <i class="material-icons">schedule</i>
                                    <span class="timer-text"></span>
                                </span>
                            ` : ''}
                            <span style="color: #666; font-size: 0.9em;">
                                <i class="material-icons" style="font-size: 18px; vertical-align: middle;">people</i>
                                ${poll.total_votes} vote${poll.total_votes > 1 ? 's' : ''}
                            </span>
                        </div>
                    </div>

                    <div class="poll-options">
                        ${isCreator ? `
                            <div style="padding: 15px; background: #fff3cd; border-radius: 8px; margin-bottom: 15px; color: #856404;">
                                <i class="material-icons" style="vertical-align: middle;">info</i>
                                Vous êtes le créateur de ce ${poll.poll_category === 'vote' ? 'vote' : 'sondage'}
                            </div>
                        ` : ''}
                        
                        ${hasVoted ? `
                            <div style="padding: 15px; background: #d4edda; border-radius: 8px; margin-bottom: 15px; color: #155724;">
                                <i class="material-icons" style="vertical-align: middle;">check_circle</i>
                                Vous avez déjà voté
                            </div>
                        ` : ''}
                        
                        ${poll.options.map(option => `
                            <div class="option-item ${hasVoted ? 'voted' : ''} ${!canVote ? 'disabled' : ''}" 
                                 data-option-id="${option.id}">
                                ${canVote ? `
                                    <div class="option-radio ${poll.poll_type === 'single' ? 'radio' : 'checkbox'}"></div>
                                ` : ''}
                                <div class="option-content">
                                    ${option.option_image ? `
                                        <img src="${option.option_image}" alt="${escapeHtml(option.option_text)}" class="option-image">
                                    ` : ''}
                                    <span class="option-text">${escapeHtml(option.option_text)}</span>
                                </div>
                            </div>
                        `).join('')}
                        
                        ${canVote ? `
                            <button class="vote-button" data-poll-id="${poll.id}">
                                <i class="material-icons">how_to_vote</i>
                                Voter
                            </button>
                        ` : ''}
                        
                        ${!isActive || hasVoted ? `
                            <button class="vote-button" onclick="showResults(${poll.id})">
                                <i class="material-icons">bar_chart</i>
                                Voir les résultats
                            </button>
                        ` : ''}
                    </div>

                    ${totalReactions > 0 ? `
                        <div class="reactions-summary">
                            ${Object.entries(reactionsByType).map(([type, data]) => {
                                const reaction = REACTIONS.find(r => r.type === type);
                                return `
                                    <div class="reaction-count" onclick="showReactionDetails(${poll.id}, '${type}')">
                                        <span class="reaction-emoji">${reaction ? reaction.emoji : '👍'}</span>
                                        <span class="reaction-user-count">${data.count}</span>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                    ` : ''}

                    <div class="poll-interactions">
                        <div class="interactions-left">
                            <div class="reaction-btn-wrapper">
                                <button class="interaction-btn reaction-btn ${userReactionType ? 'active' : ''}" 
                                        data-poll-id="${poll.id}"
                                        onmouseenter="showReactionPreview(${poll.id}, this)"
                                        onmouseleave="scheduleHidePreview()"
                                        onclick="if(!event.target.closest('.reaction-preview')) showReactionsModal(${poll.id})">
                                    ${userReactionType ? 
                                        `<span class="reaction-emoji">${getReactionEmoji(userReactionType)}</span>` :
                                        `<i class="material-icons">thumb_up</i>`
                                    }
                                    <span>${totalReactions || 0}</span>
                                </button>
                                <div class="reaction-preview" id="reactionPreview-${poll.id}">
                                    ${REACTIONS.map(reaction => `
                                        <button class="emoji-btn" 
                                                onmouseenter="clearHidePreview()"
                                                onmouseleave="scheduleHidePreview()"
                                                onclick="submitReaction(${poll.id}, '${reaction.type}'); hideReactionPreview()">
                                            ${reaction.emoji}
                                        </button>
                                    `).join('')}
                                </div>
                            </div>
                            <button class="interaction-btn comment-btn" onclick="showComments(${poll.id})">
                                <i class="material-icons">comment</i>
                                <span>${poll.comments_count || 0}</span>
                            </button>
                            <button class="interaction-btn share-btn" onclick="showShareModal(${poll.id})">
                                <i class="material-icons">share</i>
                                <span>${poll.total_shares || 0}</span>
                            </button>
                        </div>
                        <div class="interactions-right">
                            <button class="interaction-btn view-btn">
                                <i class="material-icons">visibility</i>
                                <span>${poll.total_views || 0}</span>
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function attachPollEvents(pollId, poll) {
            const card = document.querySelector(`[data-poll-id="${pollId}"]`);
            if (!card) return;

            // Vote sur les options
            const options = card.querySelectorAll('.option-item:not(.disabled)');
            let selectedOptions = new Set();

            options.forEach(option => {
                option.addEventListener('click', function() {
                    const optionId = this.dataset.optionId;
                    
                    if (poll.poll_type === 'single') {
                        // Désélectionner toutes les autres options
                        options.forEach(opt => {
                            opt.querySelector('.option-radio')?.classList.remove('checked');
                        });
                        selectedOptions.clear();
                        selectedOptions.add(optionId);
                        this.querySelector('.option-radio').classList.add('checked');
                    } else {
                        // Mode multiple
                        const radio = this.querySelector('.option-radio');
                        if (selectedOptions.has(optionId)) {
                            selectedOptions.delete(optionId);
                            radio.classList.remove('checked');
                        } else {
                            selectedOptions.add(optionId);
                            radio.classList.add('checked');
                        }
                    }
                });
            });

            // Bouton de vote
            const voteButton = card.querySelector('.vote-button[data-poll-id]');
            if (voteButton) {
                voteButton.addEventListener('click', async function() {
                    if (selectedOptions.size === 0) {
                        alert('Veuillez sélectionner au moins une option');
                        return;
                    }

                    await submitVote(pollId, Array.from(selectedOptions));
                });
            }
        }

        async function submitVote(pollId, options) {
            try {
                const response = await fetch('/api/vote', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        poll_id: pollId,
                        options: options
                    })
                });

                const data = await response.json();

                if (data.success) {
                    showSuccess('Vote enregistré avec succès!');
                    loadPolls(); // Recharger les sondages
                } else {
                    showError(data.message || 'Erreur lors du vote');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showError('Erreur de connexion');
            }
        }

        function showReactionPreview(pollId, button) {
            hideReactionPreview();
            
            const preview = document.getElementById(`reactionPreview-${pollId}`);
            if (preview) {
                preview.classList.add('show');
                activeReactionPreview = preview;
                
                const rect = button.getBoundingClientRect();
                preview.style.left = '0';
                preview.style.bottom = '100%';
            }
        }

        function hideReactionPreview() {
            if (activeReactionPreview) {
                activeReactionPreview.classList.remove('show');
                activeReactionPreview = null;
            }
            clearTimeout(hidePreviewTimeout);
        }

        function scheduleHidePreview() {
            clearTimeout(hidePreviewTimeout);
            hidePreviewTimeout = setTimeout(hideReactionPreview, 300);
        }

        function clearHidePreview() {
            clearTimeout(hidePreviewTimeout);
        }

        function showReactionsModal(pollId) {
            currentReactionPollId = pollId;
            const modal = document.getElementById('reactionsModal');
            const grid = document.getElementById('reactionsGrid');
            
            hideReactionPreview();
            modal.classList.add('active');
            
            const poll = allPolls.find(p => p.id === pollId);
            const userReaction = poll ? poll.user_reaction : null;
            
            grid.innerHTML = REACTIONS.map(reaction => `
                <div class="reaction-choice ${userReaction === reaction.type ? 'active' : ''}" 
                     onclick="submitReaction(${pollId}, '${reaction.type}')">
                    <div class="reaction-emoji-large">${reaction.emoji}</div>
                    <div class="reaction-name">${reaction.name}</div>
                </div>
            `).join('');
        }

        async function submitReaction(pollId, reactionType) {
            try {
                const response = await fetch(`/api/polls/${pollId}/react`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ reaction_type: reactionType })
                });

                const data = await response.json();

                if (data.success) {
                    document.getElementById('reactionsModal').classList.remove('active');
                    loadPolls();
                    showSuccess(data.message || 'Réaction enregistrée');
                } else {
                    showError(data.message || 'Erreur lors de la réaction');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showError('Erreur de connexion');
            }
        }

        async function showReactionDetails(pollId, reactionType) {
            try {
                const response = await fetch(`/api/polls/${pollId}/reactions/${reactionType}`);
                const data = await response.json();

                if (data.success && data.users && data.users.length > 0) {
                    const userList = data.users.slice(0, 10).join(', ');
                    const moreCount = data.users.length > 10 ? ` et ${data.users.length - 10} autres` : '';
                    alert(`${userList}${moreCount} ont réagi avec ${getReactionEmoji(reactionType)}`);
                } else {
                    showInfo('Aucun utilisateur avec cette réaction');
                }
            } catch (error) {
                console.error('Erreur:', error);
            }
        }

        function showShareModal(pollId) {
            currentSharePollId = pollId;
            const modal = document.getElementById('shareModal');
            const container = document.getElementById('shareOptions');
            
            modal.classList.add('active');
            
            const poll = allPolls.find(p => p.id === pollId);
            if (!poll) return;
            
            const pollLink = `${window.location.origin}/poll/${pollId}`;
            const pollTitle = encodeURIComponent(poll.title || poll.question);
            const pollDescription = encodeURIComponent(poll.description || '');
            
            container.innerHTML = `
                <div class="share-option">
                    <div class="share-option-title">Lien direct</div>
                    <div class="share-link-container">
                        <input type="text" class="share-link-input" value="${pollLink}" readonly id="pollLinkInput">
                        <button class="copy-link-btn" onclick="copyPollLink()">
                            <i class="material-icons">content_copy</i>
                            Copier
                        </button>
                    </div>
                </div>
                
                <div class="share-option">
                    <div class="share-option-title">Partager sur les réseaux</div>
                    <div class="share-social-buttons">
                        <button class="social-share-btn facebook" onclick="shareOnFacebook('${pollLink}', '${pollTitle}')">
                            <i class="material-icons">facebook</i>
                            Facebook
                        </button>
                        <button class="social-share-btn twitter" onclick="shareOnTwitter('${pollLink}', '${pollTitle}')">
                            <i class="material-icons">flutter_dash</i>
                            Twitter
                        </button>
                        <button class="social-share-btn whatsapp" onclick="shareOnWhatsApp('${pollLink}', '${pollTitle}')">
                            <i class="material-icons">whatsapp</i>
                            WhatsApp
                        </button>
                        <button class="social-share-btn linkedin" onclick="shareOnLinkedIn('${pollLink}', '${pollTitle}', '${pollDescription}')">
                            <i class="material-icons">linkedin</i>
                            LinkedIn
                        </button>
                        <button class="social-share-btn email" onclick="shareByEmail('${pollLink}', '${pollTitle}')">
                            <i class="material-icons">email</i>
                            Email
                        </button>
                    </div>
                </div>
                
                <div class="share-option">
                    <div class="share-option-title">Code d'intégration</div>
                    <div class="share-link-container">
                        <input type="text" class="share-link-input" value='<iframe src="${pollLink}/embed" width="400" height="600" frameborder="0"></iframe>' readonly id="embedCodeInput">
                        <button class="copy-link-btn" onclick="copyEmbedCode()">
                            <i class="material-icons">content_copy</i>
                            Copier
                        </button>
                    </div>
                </div>
            `;
        }

        function copyPollLink() {
            const input = document.getElementById('pollLinkInput');
            input.select();
            input.setSelectionRange(0, 99999);
            
            try {
                navigator.clipboard.writeText(input.value).then(() => {
                    showCopySuccess('pollLinkBtn');
                    showSuccess('Lien copié dans le presse-papier!');
                });
            } catch (err) {
                document.execCommand('copy');
                showCopySuccess('pollLinkBtn');
                showSuccess('Lien copié dans le presse-papier!');
            }
        }

        function copyEmbedCode() {
            const input = document.getElementById('embedCodeInput');
            input.select();
            input.setSelectionRange(0, 99999);
            
            try {
                navigator.clipboard.writeText(input.value).then(() => {
                    showCopySuccess('embedCodeBtn');
                    showSuccess('Code d\'intégration copié!');
                });
            } catch (err) {
                document.execCommand('copy');
                showCopySuccess('embedCodeBtn');
                showSuccess('Code d\'intégration copié!');
            }
        }

        function showCopySuccess(buttonId) {
            const button = document.querySelector(`.copy-link-btn[onclick*="${buttonId}"]`);
            if (button) {
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="material-icons">check</i> Copié!';
                button.classList.add('copied');
                
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.classList.remove('copied');
                }, 2000);
            }
        }

        function shareOnFacebook(link, title) {
            const url = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(link)}&quote=${title}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('facebook');
        }

        function shareOnTwitter(link, title) {
            const url = `https://twitter.com/intent/tweet?url=${encodeURIComponent(link)}&text=${title}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('twitter');
        }

        function shareOnWhatsApp(link, title) {
            const url = `https://wa.me/?text=${encodeURIComponent(title + ' ' + link)}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('whatsapp');
        }

        function shareOnLinkedIn(link, title, description) {
            const url = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(link)}&title=${title}&summary=${description}`;
            window.open(url, '_blank', 'width=600,height=400');
            trackShare('linkedin');
        }

        function shareByEmail(link, title) {
            const url = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent('Regarde ce sondage intéressant: ' + link)}`;
            window.location.href = url;
            trackShare('email');
        }

        async function trackShare(platform) {
            try {
                await fetch(`/api/polls/${currentSharePollId}/share`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ 
                        share_platform: platform,
                        share_message: `Partagé sur ${platform}`
                    })
                });
                
                loadPolls();
            } catch (error) {
                console.error('Erreur de suivi du partage:', error);
            }
        }

        async function showComments(pollId) {
            currentPollId = pollId;
            const modal = document.getElementById('commentsModal');
            const container = document.getElementById('commentsContainer');
            
            modal.classList.add('active');
            container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';

            try {
                const response = await fetch(`/api/polls/${pollId}/comments`);
                const data = await response.json();

                if (data.success) {
                    if (data.comments.length === 0) {
                        container.innerHTML = '<p style="text-align: center; color: #999;">Aucun commentaire pour le moment</p>';
                    } else {
                        container.innerHTML = renderComments(data.comments);
                    }
                }
            } catch (error) {
                console.error('Erreur:', error);
                container.innerHTML = '<p style="text-align: center; color: red;">Erreur lors du chargement des commentaires</p>';
            }
        }

        function renderComments(comments) {
            return comments.map(comment => `
                <div class="comment-item">
                    <div class="comment-header">
                        <div class="comment-author">
                            ${escapeHtml(comment.user_name)}
                        </div>
                        <span class="comment-date">${formatDate(comment.created_at)}</span>
                    </div>
                    <div class="comment-text">
                        ${escapeHtml(comment.comment_text)}
                    </div>
                </div>
            `).join('');
        }

        async function submitComment() {
            const input = document.getElementById('commentInput');
            const text = input.value.trim();

            if (!text) {
                alert('Le commentaire ne peut pas être vide');
                return;
            }

            try {
                const payload = {
                    comment_text: text
                };

                const response = await fetch(`/api/polls/${currentPollId}/comment`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (data.success) {
                    input.value = '';
                    showComments(currentPollId);
                    loadPolls();
                    showSuccess('Commentaire publié avec succès!');
                } else {
                    showError(data.message || 'Erreur lors de l\'ajout du commentaire');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showError('Erreur de connexion');
            }
        }

        async function showResults(pollId) {
            const modal = document.getElementById('resultsModal');
            const container = document.getElementById('resultsContainer');
            
            modal.classList.add('active');
            container.innerHTML = '<div class="loading"><div class="spinner"></div></div>';

            try {
                const response = await fetch(`/api/polls/${pollId}/results-explorer`);
                const data = await response.json();

                if (data.success) {
                    const maxVotes = Math.max(...data.results.map(r => r.vote_count), 1);
                    
                    container.innerHTML = `
                        <div style="margin-bottom: 20px; text-align: center;">
                            <h3>Total: ${data.total_votes} vote${data.total_votes > 1 ? 's' : ''}</h3>
                        </div>
                        ${data.results.map(result => {
                            const percentage = data.total_votes > 0 ? (result.vote_count / data.total_votes * 100).toFixed(1) : 0;
                            return `
                                <div class="result-item">
                                    <div class="result-header">
                                        <span class="result-option">${escapeHtml(result.option_text)}</span>
                                        <span class="result-votes">${result.vote_count} vote${result.vote_count > 1 ? 's' : ''}</span>
                                    </div>
                                    <div class="result-bar">
                                        <div class="result-bar-fill" style="width: ${percentage}%">
                                            ${percentage}%
                                        </div>
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    `;
                } else {
                    container.innerHTML = `<p style="text-align: center; color: red;">${data.message}</p>`;
                }
            } catch (error) {
                console.error('Erreur:', error);
                container.innerHTML = '<p style="text-align: center; color: red;">Erreur lors du chargement des résultats</p>';
            }
        }

        function updateTimers() {
            document.querySelectorAll('.time-remaining').forEach(timer => {
                const endTime = new Date(timer.dataset.endTime);
                const now = new Date();
                const diff = Math.max(0, Math.floor((endTime - now) / 1000));

                const timerText = timer.querySelector('.timer-text');
                if (timerText) {
                    timerText.textContent = formatTimeRemaining(diff);
                }

                if (diff === 0) {
                    setTimeout(() => {
                        loadPolls();
                    }, 1000);
                }
            });
        }

        function formatTimeRemaining(seconds) {
            if (seconds === 0) return 'Terminé';
            
            const days = Math.floor(seconds / 86400);
            const hours = Math.floor((seconds % 86400) / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = seconds % 60;

            if (days > 0) return `${days}j ${hours}h`;
            if (hours > 0) return `${hours}h ${minutes}m`;
            if (minutes > 0) return `${minutes}m ${secs}s`;
            return `${secs}s`;
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            const now = new Date();
            const diff = Math.floor((now - date) / 1000);

            if (diff < 60) return 'À l\'instant';
            if (diff < 3600) return `Il y a ${Math.floor(diff / 60)} min`;
            if (diff < 86400) return `Il y a ${Math.floor(diff / 3600)} h`;
            if (diff < 604800) return `Il y a ${Math.floor(diff / 86400)} j`;
            
            return date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' });
        }

        function getReactionEmoji(type) {
            const reaction = REACTIONS.find(r => r.type === type);
            return reaction ? reaction.emoji : '👍';
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showSuccess(message) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #4CAF50;
                color: white;
                padding: 12px 24px;
                border-radius: 8px;
                z-index: 10000;
                animation: slideIn 0.3s ease;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => document.body.removeChild(toast), 300);
            }, 3000);
        }

        function showError(message) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #f44336;
                color: white;
                padding: 12px 24px;
                border-radius: 8px;
                z-index: 10000;
                animation: slideIn 0.3s ease;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => document.body.removeChild(toast), 300);
            }, 3000);
        }

        function showInfo(message) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: #2196F3;
                color: white;
                padding: 12px 24px;
                border-radius: 8px;
                z-index: 10000;
                animation: slideIn 0.3s ease;
            `;
            toast.textContent = message;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => document.body.removeChild(toast), 300);
            }, 3000);
        }

        // Ajouter les styles d'animation pour les toasts
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);
        
        // Mettre à jour les timers
        setInterval(updateTimers, 1000);
        
        // Exposer les fonctions globales
        window.refreshPollsCount = loadActivePollsCount;
        window.getCurrentFilter = () => currentFilter;
        window.showReactionPreview = showReactionPreview;
        window.scheduleHidePreview = scheduleHidePreview;
        window.clearHidePreview = clearHidePreview;
        window.hideReactionPreview = hideReactionPreview;
        window.showReactionsModal = showReactionsModal;
        window.submitReaction = submitReaction;
        window.showReactionDetails = showReactionDetails;
        window.showShareModal = showShareModal;
        window.copyPollLink = copyPollLink;
        window.copyEmbedCode = copyEmbedCode;
        window.shareOnFacebook = shareOnFacebook;
        window.shareOnTwitter = shareOnTwitter;
        window.shareOnWhatsApp = shareOnWhatsApp;
        window.shareOnLinkedIn = shareOnLinkedIn;
        window.shareByEmail = shareByEmail;
        window.showComments = showComments;
        window.showResults = showResults;
        window.submitVote = submitVote;
    </script>
