<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorer - iVote</title>
    
    <!-- Google Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- AOS pour les animations -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            --success-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --warning-gradient: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
            --card-gradient: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
            --shadow-soft: 0 10px 40px rgba(0, 0, 0, 0.08);
            --shadow-hover: 0 20px 60px rgba(0, 0, 0, 0.12);
        }
        
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            overflow-x: hidden;
        }
        
        /* Header décoré du premier code */
        .explorer-header {
            background: var(--primary-gradient);
            border-radius: 24px;
            padding: 3rem 2rem;
            margin-bottom: 2rem;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
            margin-left: 0.5rem;
            margin-right: 0.5rem;
        }
        
        .explorer-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            opacity: 0.1;
            animation: float 20s linear infinite;
        }
        
        @keyframes float {
            0% { transform: translate(0, 0) rotate(0deg); }
            100% { transform: translate(-50px, -50px) rotate(360deg); }
        }
        
        .explorer-header h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 1rem;
            background: linear-gradient(to right, #ffffff, #e2e8f0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }
        
        .explorer-header p {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }
        
        /* Filtres améliorés du premier code */
        .filters-section {
            background: white;
            border-radius: 20px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            box-shadow: var(--shadow-soft);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            margin-left: 0.5rem;
            margin-right: 0.5rem;
        }
        
        .filter-group {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
        }
        
        .filter-btn {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 24px;
            border: 2px solid transparent;
            background: linear-gradient(145deg, #f8fafc, #f1f5f9);
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-weight: 600;
            color: #4a5568;
            position: relative;
            overflow: hidden;
        }
        
        .filter-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            transition: left 0.6s;
        }
        
        .filter-btn:hover::before {
            left: 100%;
        }
        
        .filter-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.2);
            border-color: #667eea;
            background: white;
        }
        
        .filter-btn.active {
            background: var(--primary-gradient);
            color: white;
            border-color: #667eea;
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
            transform: translateY(-2px);
        }
        
        .filter-btn i {
            font-size: 1.2rem;
        }
        
        /* Wave animation for header */
        .wave-container {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            overflow: hidden;
            line-height: 0;
        }
        
        .wave {
            position: relative;
            display: block;
            width: calc(100% + 1.3px);
            height: 50px;
        }
        
        .wave .shape-fill {
            fill: rgba(255, 255, 255, 0.1);
        }
        
        /* Stats badge */
        .stats-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            border-radius: 50px;
            padding: 8px 16px;
            font-size: 0.9rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        /* Floating particles */
        .floating-particles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        
        .particle {
            position: absolute;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            animation: floatParticle 15s infinite linear;
        }
        
        @keyframes floatParticle {
            0% {
                transform: translateY(0) translateX(0) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100vh) translateX(100px) rotate(360deg);
                opacity: 0;
            }
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .explorer-header {
                padding: 2rem 1rem;
                border-radius: 20px;
            }
            
            .explorer-header h1 {
                font-size: 2.5rem;
            }
            
            .filter-group {
                justify-content: flex-start;
                overflow-x: auto;
                padding-bottom: 10px;
                margin-left: 0;
                margin-right: 0;
            }
            
            .filter-btn {
                flex-shrink: 0;
            }
        }
        
        @media (max-width: 480px) {
            .explorer-header h1 {
                font-size: 2rem;
            }
        }
        
        /* Styles du deuxième code (inchangés) */
        .explorer-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        
        .polls-list {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        
        .poll-card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 0.6s ease forwards;
        }
        
        .poll-card.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .poll-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }
        
        .poll-header {
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
        }
        
        .poll-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }
        
        .poll-author {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .author-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
        }
        
        .author-info h3 {
            margin: 0;
            font-size: 1em;
            color: #333;
        }
        
        .author-info span {
            font-size: 0.85em;
            color: #999;
        }
        
        .poll-category {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 500;
        }
        
        .poll-category.sondage {
            background: #e3f2fd;
            color: #1976d2;
        }
        
        .poll-category.vote {
            background: #f3e5f5;
            color: #7b1fa2;
        }
        
        .poll-title {
            font-size: 1.3em;
            color: #333;
            margin-bottom: 10px;
        }
        
        .poll-question {
            color: #666;
            font-size: 1.05em;
            margin-bottom: 15px;
        }
        
        .poll-status {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            background: #f5f5f5;
            border-radius: 8px;
        }
        
        .status-badge {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 15px;
            font-size: 0.85em;
            font-weight: 500;
        }
        
        .status-badge.active {
            background: #4caf50;
            color: white;
        }
        
        .status-badge.closed {
            background: #9e9e9e;
            color: white;
        }
        
        .time-remaining {
            display: flex;
            align-items: center;
            gap: 5px;
            color: #666;
            font-size: 0.9em;
        }
        
        .poll-options {
            padding: 20px;
        }
        
        .option-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            margin-bottom: 10px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .option-item:hover:not(.voted) {
            border-color: #4CAF50;
            background: #f1f8f4;
        }
        
        .option-item.voted {
            border-color: #4CAF50;
            background: #e8f5e9;
        }
        
        .option-item.disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }
        
        .option-radio {
            width: 24px;
            height: 24px;
            min-width: 24px;
            border: 2px solid #4CAF50;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .option-radio.checked::after {
            content: '';
            width: 12px;
            height: 12px;
            background: #4CAF50;
            border-radius: 50%;
        }
        
        .option-content {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .option-image {
            width: 60px;
            height: 60px;
            border-radius: 8px;
            object-fit: cover;
        }
        
        .option-text {
            flex: 1;
            font-size: 1em;
            color: #333;
        }
        
        .vote-button {
            margin-top: 15px;
            width: 100%;
            padding: 12px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.3s;
        }
        
        .vote-button:hover:not(:disabled) {
            background: #45a049;
        }
        
        .vote-button:disabled {
            background: #ccc;
            cursor: not-allowed;
        }
        
        .poll-interactions {
            padding: 15px 20px;
            border-top: 1px solid #e0e0e0;
            display: flex;
            justify-content: space-between;
        }
        
        .interactions-left, .interactions-right {
            display: flex;
            gap: 15px;
        }
        
        .interaction-btn {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 8px 15px;
            background: transparent;
            border: none;
            border-radius: 20px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9em;
            color: #666;
        }
        
        .interaction-btn:hover {
            background: #f5f5f5;
        }
        
        .interaction-btn.active {
            color: #4CAF50;
            font-weight: 500;
        }
        
        .reaction-btn-wrapper {
            position: relative;
        }
        
        .reaction-preview {
            display: none;
            position: absolute;
            bottom: 100%;
            left: 0;
            background: white;
            border-radius: 25px;
            padding: 8px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            z-index: 100;
            margin-bottom: 10px;
            animation: fadeIn 0.2s ease;
            border: 1px solid #e0e0e0;
        }
        
        .reaction-preview.show {
            display: flex;
        }
        
        .reaction-preview .emoji-btn {
            font-size: 1.8em;
            padding: 8px;
            background: none;
            border: none;
            cursor: pointer;
            transition: transform 0.2s;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 45px;
            height: 45px;
        }
        
        .reaction-preview .emoji-btn:hover {
            transform: scale(1.3);
            background: #f5f5f5;
        }
        
        .reactions-summary {
            display: flex;
            gap: 8px;
            padding: 10px 20px;
            border-top: 1px solid #e0e0e0;
        }
        
        .reaction-count {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            background: #f5f5f5;
            border-radius: 15px;
            font-size: 0.85em;
            cursor: pointer;
            transition: background 0.3s;
        }
        
        .reaction-count:hover {
            background: #e8f5e9;
        }
        
        .reaction-emoji {
            font-size: 1.2em;
        }
        
        .reaction-user-count {
            font-weight: 500;
        }
        
        .loading-more {
            text-align: center;
            padding: 20px;
            color: #666;
        }
        
        .end-of-content {
            text-align: center;
            padding: 30px;
            color: #999;
            font-style: italic;
        }
        
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        
        .modal.active {
            display: flex;
        }
        
        .modal-content {
            background: white;
            border-radius: 12px;
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
        }
        
        .reactions-modal .modal-content,
        .share-modal .modal-content {
            max-width: 500px;
        }
        
        .modal-header {
            padding: 20px;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .modal-header h2 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }
        
        .close-modal {
            background: none;
            border: none;
            cursor: pointer;
            color: #999;
        }
        
        .modal-body {
            padding: 20px;
            overflow-y: auto;
            flex: 1;
        }
        
        .reactions-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }
        
        .reaction-choice {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s;
            background: white;
        }
        
        .reaction-choice:hover {
            border-color: #4CAF50;
            background: #f8f9fa;
            transform: translateY(-2px);
        }
        
        .reaction-choice.active {
            border-color: #4CAF50;
            background: #e8f5e9;
        }
        
        .reaction-emoji-large {
            font-size: 2.5em;
            margin-bottom: 8px;
        }
        
        .reaction-name {
            font-size: 0.9em;
            color: #666;
        }
        
        .share-options {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        
        .share-option {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 15px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            background: white;
        }
        
        .share-option-title {
            font-weight: 500;
            color: #333;
            margin-bottom: 5px;
        }
        
        .share-link-container {
            display: flex;
            gap: 10px;
        }
        
        .share-link-input {
            flex: 1;
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.9em;
            background: #f5f5f5;
            cursor: pointer;
        }
        
        .share-link-input:focus {
            outline: none;
            border-color: #4CAF50;
        }
        
        .copy-link-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 20px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9em;
            transition: background 0.3s;
        }
        
        .copy-link-btn:hover {
            background: #45a049;
        }
        
        .copy-link-btn.copied {
            background: #2E7D32;
        }
        
        .share-social-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }
        
        .social-share-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 15px;
            border: 2px solid #e0e0e0;
            background: white;
            border-radius: 25px;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 0.9em;
        }
        
        .social-share-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        
        .social-share-btn.facebook {
            border-color: #1877F2;
            color: #1877F2;
        }
        
        .social-share-btn.twitter {
            border-color: #1DA1F2;
            color: #1DA1F2;
        }
        
        .social-share-btn.whatsapp {
            border-color: #25D366;
            color: #25D366;
        }
        
        .social-share-btn.linkedin {
            border-color: #0077B5;
            color: #0077B5;
        }
        
        .social-share-btn.email {
            border-color: #666;
            color: #666;
        }
        
        .comments-container {
            margin-bottom: 20px;
        }
        
        .comment-item {
            padding: 15px;
            background: #f5f5f5;
            border-radius: 8px;
            margin-bottom: 10px;
            position: relative;
        }
        
        .comment-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            align-items: center;
        }
        
        .comment-author {
            font-weight: 500;
            color: #333;
        }
        
        .comment-date {
            font-size: 0.85em;
            color: #999;
        }
        
        .comment-text {
            color: #666;
            line-height: 1.5;
        }
        
        .add-comment-section {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        
        .add-comment-section textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            resize: vertical;
            font-family: inherit;
        }
        
        .btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 20px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 1em;
            transition: background 0.3s;
        }
        
        .btn-primary:hover {
            background: #45a049;
        }
        
        .result-item {
            margin-bottom: 20px;
        }
        
        .result-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
        }
        
        .result-option {
            font-weight: 500;
            color: #333;
        }
        
        .result-votes {
            color: #4CAF50;
            font-weight: 500;
        }
        
        .result-bar {
            height: 30px;
            background: #e0e0e0;
            border-radius: 15px;
            overflow: hidden;
            position: relative;
        }
        
        .result-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #4CAF50, #45a049);
            transition: width 0.5s ease;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 10px;
            color: white;
            font-weight: 500;
            font-size: 0.9em;
        }
        
        .loading {
            text-align: center;
            padding: 40px;
        }
        
        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #4CAF50;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 15px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: #999;
        }
        
        .empty-state i {
            font-size: 64px;
            margin-bottom: 20px;
            opacity: 0.5;
        }
        
        @media (max-width: 768px) {
            .explorer-container {
                padding: 10px;
            }
            
            .filter-group {
                justify-content: center;
            }
            
            .poll-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
            
            .interactions-left, .interactions-right {
                flex-wrap: wrap;
            }
            
            .reactions-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            
            .reaction-preview {
                padding: 5px;
            }
            
            .reaction-preview .emoji-btn {
                font-size: 1.5em;
                width: 40px;
                height: 40px;
                padding: 5px;
            }
            
            .share-link-container {
                flex-direction: column;
            }
            
            .share-social-buttons {
                flex-direction: column;
            }
        }
    </style>
</head>
<body class="p-4 md:p-6">
    <div class="max-w-7xl mx-auto">
        <!-- Header décoré du premier code -->
        <div class="explorer-header" data-aos="fade-down">
            <div class="floating-particles" id="particles"></div>
            <div class="stats-badge">
                <i class="material-icons">trending_up</i>
                <span id="totalPollsCount">0</span> sondages actifs
            </div>
            
            <h1>
                <i class="material-icons">explore</i>
                Explorer
            </h1>
            <p>Découvrez et participez aux sondages et votes de la communauté</p>
            
            <div class="wave-container">
                <svg class="wave" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
                    <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
                </svg>
            </div>
        </div>

        <!-- Filtres améliorés du premier code -->
        <div class="filters-section" data-aos="fade-up" data-aos-delay="100">
            <div class="filter-group">
                <button class="filter-btn active" data-filter="all">
                    <i class="material-icons">all_inclusive</i>
                    Tous
                </button>
                <button class="filter-btn" data-filter="sondage">
                    <i class="material-icons">poll</i>
                    Sondages
                </button>
                <button class="filter-btn" data-filter="vote">
                    <i class="material-icons">how_to_vote</i>
                    Votes officiels
                </button>
                <button class="filter-btn" data-filter="active">
                    <i class="material-icons">timer</i>
                    En cours
                </button>
                <button class="filter-btn" data-filter="closed">
                    <i class="material-icons">check_circle</i>
