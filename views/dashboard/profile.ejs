<div class="bg-white rounded-xl shadow-lg p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Mon Profil</h1>
    
   
        <!-- Informations principales -->
        <div class="flex-1">
            <h2 class="text-3xl font-bold text-gray-900"><%= user.name %></h2>
            <div class="flex flex-wrap gap-4 mt-3">
                <div class="flex items-center text-gray-600">
                    <span class="material-icons mr-2 text-indigo-500">email</span>
                    <span><%= user.email %></span>
                    <% if (user.verified) { %>
                        <span class="ml-2 px-2 py-1 text-xs bg-green-100 text-green-800 rounded-full">✓ Vérifié</span>
                    <% } %>
                </div>
                <% if (user.telephone) { %>
                <div class="flex items-center text-gray-600">
                    <span class="material-icons mr-2 text-indigo-500">phone</span>
                    <span><%= user.country_code || '+212' %> <%= user.telephone %></span>
                </div>
                <% } %>
                <div class="flex items-center text-gray-600">
                    <span class="material-icons mr-2 text-indigo-500">calendar_today</span>
                    <span>Membre depuis <%= user.joinDate %></span>
                </div>
            </div>
            
            <!-- Boutons d'action -->
            <div class="flex gap-3 mt-4">
                <a href="/profile/edit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition flex items-center">
                    <span class="material-icons mr-2 text-sm">edit</span>
                    Modifier le profil
                </a>
                <button id="changePasswordBtn" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition flex items-center">
                    <span class="material-icons mr-2 text-sm">lock</span>
                    Changer mot de passe
                </button>
            </div>
        </div>
    </div>
    
    <!-- Statistiques -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="stat-card bg-gradient-to-br from-indigo-50 to-indigo-100 p-5 rounded-lg">
            <div class="flex items-center">
                <div class="p-3 bg-indigo-600 rounded-lg">
                    <span class="material-icons text-white">poll</span>
                </div>
                <div class="ml-4">
                    <h3 class="text-2xl font-bold text-gray-900"><%= stats.createdPolls %></h3>
                    <p class="text-gray-600 text-sm">Sondages créés</p>
                </div>
            </div>
        </div>
        
        <div class="stat-card bg-gradient-to-br from-green-50 to-green-100 p-5 rounded-lg">
            <div class="flex items-center">
                <div class="p-3 bg-green-600 rounded-lg">
                    <span class="material-icons text-white">how_to_vote</span>
                </div>
                <div class="ml-4">
                    <h3 class="text-2xl font-bold text-gray-900"><%= stats.totalVotes %></h3>
                    <p class="text-gray-600 text-sm">Votes donnés</p>
                </div>
            </div>
        </div>
        
        <div class="stat-card bg-gradient-to-br from-purple-50 to-purple-100 p-5 rounded-lg">
            <div class="flex items-center">
                <div class="p-3 bg-purple-600 rounded-lg">
                    <span class="material-icons text-white">group</span>
                </div>
                <div class="ml-4">
                    <h3 class="text-2xl font-bold text-gray-900"><%= stats.followers %></h3>
                    <p class="text-gray-600 text-sm">Abonnés</p>
                </div>
            </div>
        </div>
        
        <div class="stat-card bg-gradient-to-br from-orange-50 to-orange-100 p-5 rounded-lg">
            <div class="flex items-center">
                <div class="p-3 bg-orange-600 rounded-lg">
                    <span class="material-icons text-white">supervisor_account</span>
                </div>
                <div class="ml-4">
                    <h3 class="text-2xl font-bold text-gray-900"><%= stats.following %></h3>
                    <p class="text-gray-600 text-sm">Abonnements</p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Contenu en deux colonnes -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Sondages récents -->
        <div class="bg-white rounded-lg border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Sondages récents</h3>
                <a href="/polls?filter=created" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                    Voir tous →
                </a>
            </div>
            
            <% if (recentPolls.length > 0) { %>
                <div class="space-y-4">
                    <% recentPolls.forEach(poll => { %>
                    <div class="border border-gray-100 rounded-lg p-4 hover:bg-gray-50 transition">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-medium text-gray-800"><%= poll.title || poll.question %></h4>
                                <div class="flex items-center mt-2 space-x-2">
                                    <% if (poll.category_name) { %>
                                    <span class="px-2 py-1 text-xs bg-gray-100 text-gray-600 rounded">
                                        <%= poll.category_name %>
                                    </span>
                                    <% } %>
                                    <span class="px-2 py-1 text-xs <%= poll.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %> rounded">
                                        <%= poll.status === 'active' ? 'Actif' : 'Terminé' %>
                                    </span>
                                </div>
                            </div>
                            <div class="text-right">
                                <span class="text-sm text-gray-500">
                                    <%= poll.total_votes %> votes
                                </span>
                                <div class="text-xs text-gray-400 mt-1">
                                    <%= new Date(poll.created_at).toLocaleDateString('fr-FR') %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-8">
                    <span class="material-icons text-gray-400 text-5xl mb-3">poll</span>
                    <p class="text-gray-500">Aucun sondage créé</p>
                    <a href="/poll/create" class="mt-3 inline-block text-indigo-600 hover:text-indigo-800">
                        Créer votre premier sondage →
                    </a>
                </div>
            <% } %>
        </div>
        
        <!-- Votes récents -->
        <div class="bg-white rounded-lg border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Votes récents</h3>
                <a href="/polls?filter=voted" class="text-indigo-600 hover:text-indigo-800 text-sm font-medium">
                    Voir tous →
                </a>
            </div>
            
            <% if (recentVotes.length > 0) { %>
                <div class="space-y-4">
                    <% recentVotes.forEach(vote => { %>
                    <div class="border border-gray-100 rounded-lg p-4 hover:bg-gray-50 transition">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-medium text-gray-800">
                                    <%= vote.poll_title || vote.poll_question %>
                                </h4>
                                <p class="text-sm text-gray-600 mt-1">
                                    <span class="font-medium">Votre vote:</span> <%= vote.selected_option %>
                                </p>
                                <div class="flex items-center mt-2 space-x-2">
                                    <span class="text-xs text-gray-500">
                                        Par <%= vote.poll_creator_name %>
                                    </span>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-xs text-gray-400">
                                    <%= new Date(vote.voted_at).toLocaleDateString('fr-FR') %>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-8">
                    <span class="material-icons text-gray-400 text-5xl mb-3">how_to_vote</span>
                    <p class="text-gray-500">Aucun vote récent</p>
                    <a href="/explorer" class="mt-3 inline-block text-indigo-600 hover:text-indigo-800">
                        Explorer les sondages →
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Modal pour changer le mot de passe -->
<div id="passwordModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl shadow-xl max-w-md w-full">
        <div class="p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold text-gray-800">Changer le mot de passe</h3>
                <button id="closePasswordModal" class="text-gray-400 hover:text-gray-600">
                    <span class="material-icons">close</span>
                </button>
            </div>
            
            <form id="passwordForm">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Mot de passe actuel
                        </label>
                        <input 
                            type="password" 
                            name="currentPassword"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
                            required
                        >
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Nouveau mot de passe
                        </label>
                        <input 
                            type="password" 
                            name="newPassword"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
                            required
                            minlength="8"
                        >
                        <p class="text-xs text-gray-500 mt-1">Minimum 8 caractères</p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Confirmer le nouveau mot de passe
                        </label>
                        <input 
                            type="password" 
                            name="confirmPassword"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition"
                            required
                            minlength="8"
                        >
                    </div>
                </div>
                
                <div class="mt-6 flex justify-end space-x-3">
                    <button 
                        type="button" 
                        id="cancelPasswordChange"
                        class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition"
                    >
                        Annuler
                    </button>
                    <button 
                        type="submit" 
                        class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition"
                    >
                        Changer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion de l'upload d'avatar
    const avatarUpload = document.getElementById('avatarUpload');
    const avatarPreview = document.getElementById('avatarPreview');
    
    if (avatarUpload && avatarPreview) {
        avatarUpload.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file && file.type.startsWith('image/')) {
                const reader = new FileReader();
                
                reader.onload = function(event) {
                    avatarPreview.src = event.target.result;
                    
                    // Envoyer l'image au serveur
                    fetch('/api/profile/avatar', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ avatar: event.target.result })
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            showToast('Photo de profil mise à jour', 'success');
                        } else {
                            showToast(data.message || 'Erreur lors de la mise à jour', 'error');
                        }
                    })
                    .catch(error => {
                        console.error('Erreur:', error);
                        showToast('Erreur serveur', 'error');
                    });
                };
                
                reader.readAsDataURL(file);
            }
        });
    }
    
    // Gestion du modal de changement de mot de passe
    const passwordModal = document.getElementById('passwordModal');
    const changePasswordBtn = document.getElementById('changePasswordBtn');
    const closePasswordModal = document.getElementById('closePasswordModal');
    const cancelPasswordChange = document.getElementById('cancelPasswordChange');
    const passwordForm = document.getElementById('passwordForm');
    
    if (changePasswordBtn) {
        changePasswordBtn.addEventListener('click', () => {
            passwordModal.classList.remove('hidden');
            passwordModal.classList.add('flex');
        });
    }
    
    if (closePasswordModal) {
        closePasswordModal.addEventListener('click', () => {
            passwordModal.classList.add('hidden');
            passwordModal.classList.remove('flex');
            passwordForm.reset();
        });
    }
    
    if (cancelPasswordChange) {
        cancelPasswordChange.addEventListener('click', () => {
            passwordModal.classList.add('hidden');
            passwordModal.classList.remove('flex');
            passwordForm.reset();
        });
    }
    
    // Fermer le modal en cliquant à l'extérieur
    passwordModal.addEventListener('click', (e) => {
        if (e.target === passwordModal) {
            passwordModal.classList.add('hidden');
            passwordModal.classList.remove('flex');
            passwordForm.reset();
        }
    });
    
    // Soumission du formulaire de changement de mot de passe
    if (passwordForm) {
        passwordForm.addEventListener('submit', (e) => {
            e.preventDefault();
            
            const formData = {
                currentPassword: passwordForm.currentPassword.value,
                newPassword: passwordForm.newPassword.value,
                confirmPassword: passwordForm.confirmPassword.value
            };
            
            // Vérification côté client
            if (formData.newPassword !== formData.confirmPassword) {
                showToast('Les mots de passe ne correspondent pas', 'error');
                return;
            }
            
            if (formData.newPassword.length < 8) {
                showToast('Le mot de passe doit contenir au moins 8 caractères', 'error');
                return;
            }
            
            fetch('/api/profile/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(formData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showToast('Mot de passe changé avec succès', 'success');
                    passwordModal.classList.add('hidden');
                    passwordModal.classList.remove('flex');
                    passwordForm.reset();
                } else {
                    showToast(data.errors?.join(', ') || data.message || 'Erreur', 'error');
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                showToast('Erreur serveur', 'error');
            });
        });
    }
    
    // Fonction pour afficher les notifications
    function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `fixed top-4 right-4 px-6 py-3 rounded-lg shadow-lg z-50 transform transition-all duration-300 ${
            type === 'success' ? 'bg-green-500 text-white' :
            type === 'error' ? 'bg-red-500 text-white' :
            'bg-blue-500 text-white'
        }`;
        toast.textContent = message;
        document.body.appendChild(toast);
        
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(100%)';
            setTimeout(() => {
                document.body.removeChild(toast);
            }, 300);
        }, 3000);
    }
});
</script>