        // Exporter les statistiques
        async function exportStatistics(format) {
            try {
                const response = await fetch(`/api/statistics/export/${format}`);
                
                if (format === 'json' || format === 'csv') {
                    const blob = await response.blob();
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `statistiques-${Date.now()}.${format}`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                } else {
                    const data = await response.json();
                    if (data.success) {
                        alert('Export terminé avec succès!');
                    }
                }
            } catch (error) {
                console.error('Erreur lors de l\'exportation:', error);
                showError('Erreur lors de l\'exportation');
            }
        }

