    <!-- Scripts -->
    <script>
        // Variables globales
        let statisticsData = {};
        let charts = {};
        let currentTab = 'overview';
        let { jsPDF } = window.jspdf;
        
        // Initialisation
        document.addEventListener('DOMContentLoaded', async () => {
            console.log('📊 Initialisation des statistiques...');
            await loadStatistics();
            initializeCharts();
            
            // Écouteurs d'événements
            document.getElementById('activityPeriod').addEventListener('change', updateActivityChart);
            document.getElementById('customReportForm').addEventListener('submit', generateCustomReport);
            
            // Écouteur pour fermer le modal PDF en cliquant en dehors
            document.getElementById('pdfModal').addEventListener('click', function(e) {
                if (e.target === this) {
                    closePdfModal();
                }
            });
            
            // Écouteur pour les touches du clavier (Echap pour fermer)
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && document.getElementById('pdfModal').classList.contains('show')) {
                    closePdfModal();
                }
            });
        });

        // Fonctions de chargement des données
        async function loadStatistics() {
            try {
                console.log('🔄 Chargement des statistiques depuis l\'API...');
                
                const response = await fetch('/api/statistics/general', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'Cache-Control': 'no-cache'
                    }
                });
                
                console.log('📡 Réponse API reçue, status:', response.status);
                
                if (!response.ok) {
                    throw new Error(`Erreur HTTP: ${response.status}`);
                }
                
                const data = await response.json();
                console.log('📊 Données reçues:', data);
                
                if (data.success) {
                    statisticsData = data.data;
                    console.log('✅ Données statistiques chargées avec succès');
                    
                    updateDashboard();
                    updatePerformanceTab();
                    updateEngagementTab();
                    
                    // Mettre à jour le contenu total
                    const totalPolls = statisticsData.user_stats?.total_polls_created || 0;
                    document.getElementById('totalContentCount').textContent = totalPolls;
                    
                    // Cacher le loader
                    hideLoader();
                    
                    
                } else {
                    console.error('❌ Erreur dans la réponse API:', data.message);
                    showError(data.message || 'Erreur lors du chargement des statistiques');
                    hideLoader();
                }
            } catch (error) {
                console.error('❌ Erreur de chargement:', error);
                
                // Afficher des données de démonstration pour le débogage
                console.log('⚠️ Affichage des données de démonstration');
                statisticsData = getDemoData();
                updateDashboard();
                updatePerformanceTab();
                updateEngagementTab();
                
                hideLoader();
                
                showError(`Erreur de connexion: ${error.message}. Affichage des données de démonstration.`);
            }
        }

        // Fonction pour cacher le loader
        function hideLoader() {
            console.log('👋 Cacher le loader');
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.display = 'none';
            }
        }

        // Données de démonstration
        function getDemoData() {
            return {
                user_stats: {
                    total_polls_created: 12,
                    total_votes_cast: 156,
                    active_polls: 3,
                    closed_polls: 9,
                    total_comments: 24,
                    total_reactions: 89,
                    total_shares: 15,
                    total_views: 345
                },
                platform_stats: {
                    total_users: 45,
                    total_polls: 127,
                    total_votes: 2345,
                    active_polls_total: 23,
                    total_votes_official: 34,
                    total_polls_survey: 93
                },
                poll_types: [
                    { type: 'sondage', count: 85, percentage: '66.93' },
                    { type: 'vote', count: 42, percentage: '33.07' }
                ],
                recent_activity: [
                    { date: '2025-12-22', polls_created: 2, votes_cast: 45 },
                    { date: '2025-12-23', polls_created: 3, votes_cast: 67 },
                    { date: '2025-12-24', polls_created: 1, votes_cast: 23 }
                ],
                popular_categories: [
                    { name: 'Politique', poll_count: 15, total_votes: 456 },
                    { name: 'Sport', poll_count: 12, total_votes: 389 },
                    { name: 'Technologie', poll_count: 8, total_votes: 234 },
                    { name: 'Divertissement', poll_count: 6, total_votes: 189 }
                ],
                top_polls: [
                    {
                        id: 1,
                        title: 'Meilleur sport d\'hiver',
                        question: 'Quel est votre sport d\'hiver préféré ?',
                        poll_category: 'sondage',
                        vote_count: 156,
                        options_count: 4,
                        comments_count: 12,
                        creator_name: 'Meryem Lachgar'
                    },
                    {
                        id: 2,
                        title: 'Élection du délégué',
                        question: 'Qui devrait être notre délégué ?',
                        poll_category: 'vote',
                        vote_count: 98,
                        options_count: 3,
                        comments_count: 8,
                        creator_name: 'Meryem Lachgar'
                    }
                ],
                user_ranking: 1,
                reactions_by_type: [
                    { reaction_type: 'like', count: 45 },
                    { reaction_type: 'love', count: 23 },
                    { reaction_type: 'wow', count: 12 },
                    { reaction_type: 'haha', count: 9 }
                ]
            };
        }

        // Mise à jour du tableau de bord
        function updateDashboard() {
            const stats = statisticsData.user_stats;
            const platform = statisticsData.platform_stats;
            
            console.log('📈 Mise à jour du dashboard avec:', stats);
            
            // Métriques principales avec animation
            animateCounter('totalPollsCreated', stats.total_polls_created || 0);
            animateCounter('totalVotesReceived', stats.total_votes_cast || 0);
            
            // Calculer le taux d'engagement
            const engagementRate = platform.total_votes && platform.total_polls 
                ? Math.round((platform.total_votes / platform.total_polls) * 100) 
                : 0;
            document.getElementById('engagementRate').textContent = engagementRate + '%';
            
            // Mettre à jour le classement
            document.getElementById('userRank').textContent = '#' + (statisticsData.user_ranking || 1);
            
            // Tendances
            updateTrendIndicators();
            
            // Catégories populaires
            updatePopularCategories();
            
            // Top sondages
            updateTopPolls();
            
            // Animer l'apparition
            document.querySelectorAll('.metric-card').forEach(card => {
                card.classList.add('fade-in');
            });
        }

        // Mise à jour de l'onglet Performance
        function updatePerformanceTab() {
            // Calculer les taux basés sur les données réelles
            const stats = statisticsData.user_stats;
            const totalPolls = stats.total_polls_created || 0;
            const closedPolls = stats.closed_polls || 0;
            
            // Taux de complétion
            const completionRate = totalPolls > 0 ? Math.round((closedPolls / totalPolls) * 100) : 0;
            document.getElementById('completionRateDisplay').textContent = completionRate + '%';
            document.getElementById('completionProgressText').textContent = completionRate + '%';
            document.getElementById('completionProgressBar').style.width = completionRate + '%';
            
            // Engagement moyen (votes par sondage)
            const totalVotes = stats.total_votes_cast || 0;
            const avgEngagement = totalPolls > 0 ? Math.round(totalVotes / totalPolls) : 0;
            document.getElementById('avgEngagementDisplay').textContent = avgEngagement;
            document.getElementById('minEngagement').textContent = Math.round(avgEngagement * 0.2);
            document.getElementById('maxEngagement').textContent = Math.round(avgEngagement * 1.5);
            
            // Taux de rétention (factice pour l'instant)
            const retentionRate = Math.min(100, Math.round((totalVotes / (totalPolls * 10)) * 100));
            document.getElementById('voterRetentionDisplay').textContent = retentionRate + '%';
            document.getElementById('retentionProgressBar').style.width = retentionRate + '%';
            
            // Mettre à jour le tableau de performance
            updateCategoryPerformanceTable();
        }

        // Mise à jour de l'onglet Engagement
        function updateEngagementTab() {
            const stats = statisticsData.user_stats;
            
            // Métriques d'engagement
            animateCounter('totalComments', stats.total_comments || 0);
            animateCounter('totalReactions', stats.total_reactions || 0);
            animateCounter('totalShares', stats.total_shares || 0);
            animateCounter('totalViews', stats.total_views || 0);
            
            // Mettre à jour la liste des réactions
            updateReactionsList();
            
            // Heures optimales (factices pour l'instant)
            document.getElementById('bestTimeStart').textContent = '14h';
            document.getElementById('bestTimeEnd').textContent = '18h';
            
            // Créer le graphique d'engagement horaire
            createHourlyEngagementChart();
        }

        // Mettre à jour les tendances
        function updateTrendIndicators() {
            // Simuler des tendances basées sur les données
            const stats = statisticsData.user_stats;
            const totalPolls = stats.total_polls_created || 0;
            const totalVotes = stats.total_votes_cast || 0;
            
            // Tendances aléatoires mais plausibles
            const pollsChange = Math.round(Math.random() * 30 - 10);
            const votesChange = Math.round(Math.random() * 40 - 10);
            
            // Déterminer les icônes de tendance
            const pollsTrendIcon = pollsChange > 0 ? 'trending_up' : pollsChange < 0 ? 'trending_down' : 'trending_flat';
            const votesTrendIcon = votesChange > 0 ? 'trending_up' : votesChange < 0 ? 'trending_down' : 'trending_flat';
            
            document.getElementById('pollsTrend').textContent = pollsTrendIcon;
            document.getElementById('votesTrend').textContent = votesTrendIcon;
            
            document.getElementById('pollsChange').textContent = `${pollsChange > 0 ? '+' : ''}${pollsChange}%`;
            document.getElementById('votesChange').textContent = `${votesChange > 0 ? '+' : ''}${votesChange}%`;
            
            // Mettre à jour les classes CSS pour les couleurs
            document.getElementById('pollsChange').className = pollsChange > 0 ? 'trend-up' : pollsChange < 0 ? 'trend-down' : 'trend-neutral';
            document.getElementById('votesChange').className = votesChange > 0 ? 'trend-up' : votesChange < 0 ? 'trend-down' : 'trend-neutral';
        }

        // Mettre à jour les catégories populaires
        function updatePopularCategories() {
            const tableBody = document.getElementById('popularCategoriesTable');
            if (!statisticsData.popular_categories || statisticsData.popular_categories.length === 0) {
                tableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center py-8 text-gray-500">
                            Aucune donnée disponible
                        </td>
                    </tr>
                `;
                return;
            }
            
            tableBody.innerHTML = statisticsData.popular_categories.map(category => {
                const avgVotes = category.poll_count > 0 
                    ? Math.round(category.total_votes / category.poll_count) 
                    : 0;
                const participationRate = Math.min(100, Math.round(avgVotes / 10 * 100));
                
                return `
                    <tr class="hover:bg-gray-50 fade-in">
                        <td class="font-medium text-gray-700">${category.name || 'Non catégorisé'}</td>
                        <td>${category.poll_count || 0}</td>
                        <td>${category.total_votes || 0}</td>
                        <td>${avgVotes}</td>
                        <td>
                            <div class="flex items-center">
                                <div class="w-full bg-gray-200 rounded-full h-2 mr-2">
                                    <div class="bg-green-500 h-2 rounded-full" 
                                         style="width: ${participationRate}%"></div>
                                </div>
                                <span class="text-sm">${participationRate}%</span>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Mettre à jour les top sondages
        function updateTopPolls() {
            const topPollsList = document.getElementById('topPollsList');
            if (!statisticsData.top_polls || statisticsData.top_polls.length === 0) {
                topPollsList.innerHTML = `
                    <div class="text-center py-8 text-gray-500">
                        Aucun sondage disponible
                    </div>
                `;
                return;
            }
            
            topPollsList.innerHTML = statisticsData.top_polls.map((poll, index) => `
                <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg fade-in">
                    <div class="flex items-center">
                        <div class="w-8 h-8 flex items-center justify-center bg-blue-100 text-blue-600 rounded-full mr-3">
                            ${index + 1}
                        </div>
                        <div>
                            <h4 class="font-medium text-gray-700">${poll.title}</h4>
                            <p class="text-sm text-gray-500">${poll.poll_category === 'vote' ? 'Vote officiel' : 'Sondage'}</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="font-bold text-gray-800">${poll.vote_count || 0} votes</div>
                        <div class="text-xs text-gray-500">${poll.comments_count || 0} commentaires</div>
                    </div>
                </div>
            `).join('');
        }

        // Mettre à jour la liste des réactions
        function updateReactionsList() {
            const reactionsList = document.getElementById('reactionsList');
            if (!statisticsData.reactions_by_type || statisticsData.reactions_by_type.length === 0) {
                reactionsList.innerHTML = `
                    <div class="text-center py-8 text-gray-500">
                        Aucune réaction disponible
                    </div>
                `;
                return;
            }
            
            // Mapper les icônes aux types de réactions
            const reactionIcons = {
                'like': 'thumb_up',
                'love': 'favorite',
                'wow': 'sentiment_very_satisfied',
                'haha': 'emoji_emotions',
                'sad': 'sentiment_dissatisfied',
                'angry': 'mood_bad'
            };
            
            reactionsList.innerHTML = statisticsData.reactions_by_type.map(reaction => {
                const icon = reactionIcons[reaction.reaction_type] || 'thumb_up';
                const percentage = (reaction.count / statisticsData.user_stats.total_reactions * 100).toFixed(1);
                
                return `
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg fade-in">
                        <div class="flex items-center">
                            <span class="material-icons text-blue-600 mr-3">${icon}</span>
                            <span class="font-medium text-gray-700 capitalize">${reaction.reaction_type}</span>
                        </div>
