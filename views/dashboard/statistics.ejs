<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - iVote</title>
    
    <!-- Google Material Icons -->
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- jsPDF pour la génération de PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
    
    <!-- Custom Styles -->
    <style>
        .stat-card {
            transition: all 0.3s ease;
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
        }
        
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }
        
        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }
        
        .dashboard-grid {
            display: grid;
            gap: 1.5rem;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        }
        
        .metric-card {
            background: white;
            border-radius: 1rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        
        .metric-card.gradient-blue {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            color: white;
        }
        
        .metric-card.gradient-green {
            background: linear-gradient(135deg, #10b981 0%, #047857 100%);
            color: white;
        }
        
        .metric-card.gradient-purple {
            background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
            color: white;
        }
        
        .metric-card.gradient-orange {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: white;
        }
        
        .tab-statistics {
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        
        .tab-statistics.active {
            background-color: #3b82f6;
            color: white;
        }
        
        .tab-statistics:hover:not(.active) {
            background-color: #f1f5f9;
        }
        
        .data-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }
        
        .data-table th {
            background-color: #f8fafc;
            padding: 0.75rem 1rem;
            text-align: left;
            font-weight: 600;
            color: #475569;
            border-bottom: 2px solid #e2e8f0;
        }
        
        .data-table td {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #e2e8f0;
        }
        
        .data-table tr:hover {
            background-color: #f8fafc;
        }
        
        .trend-up {
            color: #10b981;
            font-weight: 600;
        }
        
        .trend-down {
            color: #ef4444;
            font-weight: 600;
        }
        
        .trend-neutral {
            color: #6b7280;
            font-weight: 600;
        }
        
        .animated-counter {
            font-variant-numeric: tabular-nums;
        }
        
        /* Loader overlay */
        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.95);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }
        
        /* Spinner animation */
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        
        .spinner {
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3b82f6;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 1s linear infinite;
        }
        
        /* Fade in animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .fade-in {
            animation: fadeIn 0.5s ease-out;
        }
        
        /* PDF Modal - MODIFIÉ POUR ÊTRE MASQUÉ PAR DÉFAUT */
        .pdf-modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(0, 0, 0, 0.5);
            display: none; /* CHANGÉ: masqué par défaut */
            align-items: center;
            justify-content: center;
            z-index: 10000;
            padding: 20px;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .pdf-modal.show {
            display: flex; /* CHANGÉ: affiché seulement avec la classe 'show' */
            opacity: 1;
        }
        
        .pdf-modal-content {
            background: white;
            border-radius: 12px;
            width: 100%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            transform: translateY(-20px);
            transition: transform 0.3s ease;
        }
        
        .pdf-modal.show .pdf-modal-content {
            transform: translateY(0);
        }
        
        /* Responsive adjustments */
        @media (max-width: 768px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
            
            .chart-container {
                height: 250px;
            }
            
            .pdf-modal-content {
                padding: 20px;
                margin: 10px;
            }
        }
        
        /* Styles pour l'impression et PDF */
        @media print {
            .no-print {
                display: none !important;
            }
            
            body {
                background: white !important;
            }
            
            .stat-card {
                break-inside: avoid;
                box-shadow: none !important;
                border: 1px solid #ddd !important;
            }
        }
        
        /* Badges */
        .badge {
            display: inline-flex;
            align-items: center;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .badge-success {
            background-color: #d1fae5;
            color: #065f46;
        }
        
        .badge-info {
            background-color: #dbeafe;
            color: #1e40af;
        }
    </style>
</head>
<body class="bg-gray-50">
    <!-- Loader -->
    <div id="loader" class="loader-overlay">
        <div class="text-center">
            <div class="spinner mb-4"></div>
            <p class="text-gray-600 font-medium">Chargement des statistiques...</p>
        </div>
    </div>

    <!-- Modal PDF - RESTERA FERMÉ PAR DÉFAUT -->
    <div id="pdfModal" class="pdf-modal">
        <div class="pdf-modal-content">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-2xl font-bold text-gray-800">Génération de rapport PDF</h3>
                <button onclick="closePdfModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
                    <span class="material-icons text-2xl">close</span>
                </button>
            </div>
            
            <div id="pdfPreview" class="mb-6">
                <div class="bg-gray-100 p-4 rounded-lg border-2 border-dashed border-gray-300 min-h-[400px] flex items-center justify-center">
                    <div class="text-center">
                        <span class="material-icons text-gray-400 text-6xl mb-4">picture_as_pdf</span>
                        <p class="text-gray-600">Aperçu du rapport PDF en cours de génération...</p>
                    </div>
                </div>
            </div>
            
            <div id="pdfOptions" class="mb-6 p-4 bg-blue-50 rounded-lg">
                <h4 class="font-semibold text-blue-800 mb-3">Options du rapport</h4>
                <div class="space-y-3">
                    <label class="flex items-center">
                        <input type="checkbox" id="includeCharts" checked class="rounded border-gray-300 text-blue-600">
                        <span class="ml-2 text-sm text-gray-700">Inclure les graphiques</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" id="includeTables" checked class="rounded border-gray-300 text-blue-600">
                        <span class="ml-2 text-sm text-gray-700">Inclure les tableaux de données</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" id="includeSummary" checked class="rounded border-gray-300 text-blue-600">
                        <span class="ml-2 text-sm text-gray-700">Inclure le résumé exécutif</span>
                    </label>
                    <label class="flex items-center">
                        <input type="checkbox" id="includeRecommendations" checked class="rounded border-gray-300 text-blue-600">
                        <span class="ml-2 text-sm text-gray-700">Inclure les recommandations</span>
                    </label>
                </div>
            </div>
            
            <div class="flex flex-wrap gap-3 justify-end">
                <button onclick="closePdfModal()" class="px-5 py-2.5 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors">
                    Annuler
                </button>
                <button onclick="generatePdfReport()" id="generatePdfBtn" class="px-5 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors flex items-center">
                    <span class="material-icons mr-2">picture_as_pdf</span>
                    Générer le PDF
                </button>
                <button onclick="previewPdfReport()" class="px-5 py-2.5 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors flex items-center">
                    <span class="material-icons mr-2">visibility</span>
                    Prévisualiser
                </button>
            </div>
        </div>
    </div>

    <!-- Header -->
    <header >
    <div class="container mx-auto px-4 py-8">
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-[60px] shadow-lg p-6 md:p-8">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
                <div class="space-y-1">
                    <h1 class="text-4xl md:text-5xl font-extrabold">
                        <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">Statistiques</span>
                        <span class="text-gray-800"> Avancées</span>
                    </h1>
                    <p class="text-gray-600 text-sm md:text-base font-medium">
                        Analysez vos performances et l'activité de la plateforme
                    </p>
                </div>
                
                <div class="flex flex-wrap items-center gap-3">
                    <button onclick="exportStatistics('json')" 
                            class="group flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-green-200 text-green-700 rounded-xl hover:bg-green-50 hover:border-green-300 hover:shadow-md transition-all duration-200 font-medium">
                        <span class="material-icons text-xl group-hover:scale-110 transition-transform">download</span>
                        <span class="hidden sm:inline">Exporter</span> JSON
                    </button>
                    <button onclick="exportStatistics('csv')" 
                            class="group flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-blue-200 text-blue-700 rounded-xl hover:bg-blue-50 hover:border-blue-300 hover:shadow-md transition-all duration-200 font-medium">
                        <span class="material-icons text-xl group-hover:scale-110 transition-transform">file_download</span>
                        <span class="hidden sm:inline">Exporter</span> CSV
                    </button>
                    <button onclick="showPdfModal()" 
                            class="group flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-purple-200 text-purple-700 rounded-xl hover:bg-purple-50 hover:border-purple-300 hover:shadow-md transition-all duration-200 font-medium">
                        <span class="material-icons text-xl group-hover:scale-110 transition-transform">picture_as_pdf</span>
                        <span class="hidden sm:inline">Générer</span> PDF
                    </button>
                    <button onclick="window.print()" 
                            class="group flex items-center gap-2 px-5 py-2.5 bg-white border-2 border-gray-200 text-gray-700 rounded-xl hover:bg-gray-50 hover:border-gray-300 hover:shadow-md transition-all duration-200 font-medium">
                        <span class="material-icons text-xl group-hover:scale-110 transition-transform">print</span>
                        <span class="hidden sm:inline">Imprimer</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>

    <div class="container mx-auto px-4 py-8">
        <!-- Tabs de navigation -->
        <div class="mb-8">
            <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-4">
                <button onclick="switchTab('overview')" 
                        class="tab-statistics active" 
                        data-tab="overview">
                    <span class="material-icons mr-2">dashboard</span>
                    Vue d'ensemble
                </button>
                <button onclick="switchTab('performance')" 
                        class="tab-statistics" 
                        data-tab="performance">
                    <span class="material-icons mr-2">trending_up</span>
                    Performance
                </button>
                <button onclick="switchTab('engagement')" 
                        class="tab-statistics" 
                        data-tab="engagement">
                    <span class="material-icons mr-2">group</span>
                    Engagement
                </button>
                <button onclick="switchTab('export')" 
                        class="tab-statistics" 
                        data-tab="export">
                    <span class="material-icons mr-2">insert_chart</span>
                    Export & Rapports
                </button>
            </div>
        </div>

        <!-- Vue d'ensemble -->
        <div id="overviewTab" class="tab-content">
            <!-- Statistiques principales -->
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Vos statistiques principales</h2>
                <div class="dashboard-grid mb-8">
                    <!-- Cartes de métriques -->
                    <div class="metric-card gradient-blue">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm opacity-90">Sondages créés</p>
                                <h3 id="totalPollsCreated" class="text-3xl font-bold mt-2 animated-counter">0</h3>
                            </div>
                            <div class="p-3 bg-white/20 rounded-full">
                                <span class="material-icons text-2xl">poll</span>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="flex items-center text-sm">
                                <span id="pollsTrend" class="material-icons mr-1">trending_up</span>
                                <span id="pollsChange" class="trend-up">0%</span> cette semaine
                            </div>
                        </div>
                    </div>
                    
                    <div class="metric-card gradient-green">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm opacity-90">Votes reçus</p>
                                <h3 id="totalVotesReceived" class="text-3xl font-bold mt-2 animated-counter">0</h3>
                            </div>
                            <div class="p-3 bg-white/20 rounded-full">
                                <span class="material-icons text-2xl">how_to_vote</span>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="flex items-center text-sm">
                                <span id="votesTrend" class="material-icons mr-1">trending_up</span>
                                <span id="votesChange" class="trend-up">0%</span> cette semaine
                            </div>
                        </div>
                    </div>
                    
                    <div class="metric-card gradient-purple">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm opacity-90">Taux d'engagement</p>
                                <h3 id="engagementRate" class="text-3xl font-bold mt-2">0%</h3>
                            </div>
                            <div class="p-3 bg-white/20 rounded-full">
                                <span class="material-icons text-2xl">insights</span>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="text-sm">Moyenne par sondage</div>
                        </div>
                    </div>
                    
                    <div class="metric-card gradient-orange">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-sm opacity-90">Classement</p>
                                <h3 id="userRank" class="text-3xl font-bold mt-2">#1</h3>
                            </div>
                            <div class="p-3 bg-white/20 rounded-full">
                                <span class="material-icons text-2xl">emoji_events</span>
                            </div>
                        </div>
                        <div class="mt-4">
                            <div class="text-sm">Top créateur</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Graphiques principaux -->
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Activité récente</h2>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Graphique d'activité -->
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-lg font-semibold text-gray-700">Activité sur 7 jours</h3>
                            <div class="flex items-center space-x-2">
                                <span class="text-sm text-gray-500">Période:</span>
                                <select id="activityPeriod" class="border rounded-lg px-3 py-1 text-sm">
                                    <option value="7">7 jours</option>
                                    <option value="30">30 jours</option>
                                    <option value="90">90 jours</option>
                                </select>
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="activityChart"></canvas>
                        </div>
                    </div>
                    
                    <!-- Distribution des types -->
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-lg font-semibold text-gray-700">Types de contenu</h3>
                            <div class="text-sm text-gray-500">
                                <span id="totalContentCount">0</span> au total
                            </div>
                        </div>
                        <div class="chart-container">
                            <canvas id="contentTypeChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Catégories populaires -->
            <div class="mb-8">
                <div class="stat-card rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-6">Catégories populaires</h3>
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Catégorie</th>
                                    <th>Sondages</th>
                                    <th>Votes totaux</th>
                                    <th>Moyenne par sondage</th>
                                    <th>Taux de participation</th>
                                </tr>
                            </thead>
                            <tbody id="popularCategoriesTable">
                                <tr>
                                    <td colspan="5" class="text-center py-8 text-gray-500">
                                        Chargement des catégories...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Top sondages -->
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Top sondages & votes</h2>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <!-- Top par participation -->
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-lg font-semibold text-gray-700">Plus populaires</h3>
                            <span class="badge badge-success">Participation</span>
                        </div>
                        <div id="topPollsList" class="space-y-4">
                            <div class="text-center py-8 text-gray-500">
                                Chargement des sondages populaires...
                            </div>
                        </div>
                    </div>
                    
                    <!-- Performance temporelle -->
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-lg font-semibold text-gray-700">Performance mensuelle</h3>
                            <span class="badge badge-info">Tendances</span>
                        </div>
                        <div class="chart-container">
                            <canvas id="performanceChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab Performance -->
        <div id="performanceTab" class="tab-content hidden">
            <div class="mb-8">
                <h2 class="text-2xl font-bold text-gray-800 mb-6">Analyse de performance détaillée</h2>
                
                <!-- Métriques de performance -->
                <div class="dashboard-grid mb-8">
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold text-gray-700">Taux de complétion</h3>
                            <div id="completionRateDisplay" class="text-2xl font-bold text-blue-600">0%</div>
                        </div>
                        <div class="relative pt-1">
                            <div class="flex mb-2 items-center justify-between">
                                <div class="text-xs text-gray-600">Progression</div>
                                <div id="completionProgressText" class="text-xs font-semibold text-blue-600">0%</div>
                            </div>
                            <div class="overflow-hidden h-2 mb-4 text-xs flex rounded bg-blue-200">
                                <div id="completionProgressBar" style="width: 0%" 
                                     class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-blue-500 transition-all duration-500"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold text-gray-700">Engagement moyen</h3>
                            <div id="avgEngagementDisplay" class="text-2xl font-bold text-green-600">0</div>
                        </div>
                        <p class="text-sm text-gray-600 mb-4">Votes par sondage</p>
                        <div class="space-y-2">
                            <div class="flex justify-between text-sm">
                                <span>Minimum</span>
                                <span id="minEngagement" class="font-semibold">0</span>
                            </div>
                            <div class="flex justify-between text-sm">
                                <span>Maximum</span>
                                <span id="maxEngagement" class="font-semibold">0</span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold text-gray-700">Distribution par durée</h3>
                            <span class="material-icons text-blue-500">schedule</span>
                        </div>
                        <div class="chart-container" style="height: 200px;">
                            <canvas id="durationDistributionChart"></canvas>
                        </div>
                    </div>
                    
                    <div class="stat-card rounded-xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-semibold text-gray-700">Retention des votants</h3>
                            <div id="voterRetentionDisplay" class="text-2xl font-bold text-purple-600">0%</div>
                        </div>
                        <p class="text-sm text-gray-600 mb-4">Votants récurrents</p>
                        <div class="relative pt-1">
                            <div class="overflow-hidden h-2 mb-4 text-xs flex rounded bg-purple-200">
                                <div id="retentionProgressBar" style="width: 0%" 
                                     class="shadow-none flex flex-col text-center whitespace-nowrap text-white justify-center bg-purple-500 transition-all duration-500"></div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- Tableau de performance -->
                <div class="stat-card rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-700 mb-6">Performance par catégorie</h3>
                    <div class="overflow-x-auto">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Catégorie</th>
                                    <th>Sondages</th>
                                    <th>Votes totaux</th>
                                    <th>Moyenne</th>
                                    <th>Taux de complétion</th>
                                    <th>Score de performance</th>
                                </tr>
                            </thead>
                            <tbody id="categoryPerformanceTable">
