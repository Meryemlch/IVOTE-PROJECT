                        pdf.setFontSize(9);
                        pdf.setTextColor(75, 85, 99);
                        const contentLines = pdf.splitTextToSize(rec.content, pageWidth - 2 * margin);
                        pdf.text(contentLines, margin + 5, yPosition);
                        yPosition += (contentLines.length * 4) + 8;
                    });
                }
                
                // Page de conclusion
                addNewPageIfNeeded(50);
                
                pdf.setFontSize(16);
                pdf.setTextColor(31, 41, 55);
                pdf.text('Conclusion', pageWidth / 2, yPosition, { align: 'center' });
                yPosition += 15;
                
                pdf.setFontSize(10);
                pdf.setTextColor(75, 85, 99);
                const conclusion = `Votre performance sur iVote est excellente avec un classement parmi les meilleurs créateurs. 
Continuez à créer du contenu de qualité, diversifiez vos catégories, et utilisez les insights de ce rapport pour optimiser votre stratégie. 
La croissance de votre engagement démontre l'intérêt de votre audience pour vos sondages.`;
                
                const conclusionLines = pdf.splitTextToSize(conclusion, pageWidth - 2 * margin);
                pdf.text(conclusionLines, margin, yPosition);
                yPosition += (conclusionLines.length * 5) + 15;
                
                pdf.setFontSize(8);
                pdf.setTextColor(156, 163, 175); // gray-400
                pdf.text('Ce rapport a été généré automatiquement par iVote Analytics.', pageWidth / 2, yPosition, { align: 'center' });
                yPosition += 5;
                pdf.text('Pour toute question ou assistance, contactez notre équipe de support.', pageWidth / 2, yPosition, { align: 'center' });
                
                // Enregistrer le PDF
                const fileName = `rapport-statistiques-ivote-${new Date().toISOString().slice(0, 10)}.pdf`;
                pdf.save(fileName);
                
                // Ajouter à l'historique
                addToReportHistory(fileName, 'pdf');
                
                // Fermer le modal
                closePdfModal();
                
                showMessage('success', 'Rapport PDF généré avec succès!');
                
            } catch (error) {
                console.error('Erreur lors de la génération du PDF:', error);
                showError('Erreur lors de la génération du PDF: ' + error.message);
            } finally {
                // Réactiver le bouton
                generateBtn.innerHTML = originalText;
                generateBtn.disabled = false;
            }
        }

        // Capturer un graphique comme image
        async function captureChartAsImage(canvas) {
            return new Promise((resolve, reject) => {
                try {
                    // Vérifier si le canvas est valide
                    if (!canvas || canvas.width === 0 || canvas.height === 0) {
                        reject(new Error('Canvas invalide'));
                        return;
                    }
                    
                    // Capturer le canvas comme image
                    const dataUrl = canvas.toDataURL('image/png', 1.0);
                    
                    // Vérifier que l'image a été générée
                    if (dataUrl && dataUrl.length > 1000) {
                        resolve(dataUrl);
                    } else {
                        reject(new Error('Échec de la capture d\'image'));
                    }
                } catch (error) {
                    reject(error);
                }
            });
        }

        // Prévisualiser le rapport PDF
        async function previewPdfReport() {
            // Pour une vraie prévisualisation, nous pourrions générer un PDF temporaire
            // Pour l'instant, nous montrons un aperçu des options sélectionnées
            const includeCharts = document.getElementById('includeCharts').checked;
            const includeTables = document.getElementById('includeTables').checked;
            const includeSummary = document.getElementById('includeSummary').checked;
            const includeRecommendations = document.getElementById('includeRecommendations').checked;
            
            let sections = [];
            if (includeSummary) sections.push('Résumé Exécutif');
            if (includeCharts) sections.push('Graphiques (2-3)');
            if (includeTables) sections.push('Tableaux de Données');
            if (includeRecommendations) sections.push('Recommandations');
            
            alert(`Aperçu du rapport PDF:\n\nSections incluses:\n• ${sections.join('\n• ')}\n\nPages estimées: ${sections.length + 2}\nTaille estimée: 500KB-1MB\n\nCliquez sur "Générer le PDF" pour créer le rapport complet.`);
        }

        // Ajouter un rapport à l'historique
        function addToReportHistory(fileName, type) {
            const reportsHistory = document.getElementById('reportsHistory');
            const reportItem = `
                <div class="p-4 border rounded-lg hover:bg-gray-50 transition-colors fade-in">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex items-center">
                            <span class="material-icons ${type === 'pdf' ? 'text-red-500' : 'text-blue-500'} mr-2">
                                ${type === 'pdf' ? 'picture_as_pdf' : 'description'}
                            </span>
                            <h4 class="font-medium text-gray-700">${fileName}</h4>
                        </div>
                        <span class="text-xs text-gray-500">${new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</span>
                    </div>
                    <p class="text-sm text-gray-600 mb-2">Type: ${type.toUpperCase()} • Taille: ${type === 'pdf' ? '~800KB' : '~100KB'}</p>
                    <div class="flex space-x-2">
                        <button onclick="downloadReport('${fileName}')" 
                                class="text-sm text-blue-600 hover:text-blue-800 flex items-center">
                            <span class="material-icons text-sm mr-1">download</span>
                            Télécharger
                        </button>
                        <button onclick="shareReport('${fileName}')" 
                                class="text-sm text-green-600 hover:text-green-800 flex items-center">
                            <span class="material-icons text-sm mr-1">share</span>
                            Partager
                        </button>
                    </div>
                </div>
            `;
            
            if (reportsHistory.firstChild?.className?.includes('text-center')) {
                reportsHistory.innerHTML = reportItem;
            } else {
                reportsHistory.insertAdjacentHTML('afterbegin', reportItem);
            }
        }

        // Télécharger un rapport
        function downloadReport(fileName) {
            // Pour l'instant, simuler le téléchargement
            alert(`Téléchargement de "${fileName}"`);
            // En production, vous pourriez récupérer le rapport depuis le serveur
        }

        // Partager un rapport
        function shareReport(fileName) {
            // Pour l'instant, simuler le partage
            if (navigator.share) {
                navigator.share({
                    title: fileName,
                    text: 'Consultez mon rapport statistiques iVote',
                    url: window.location.href
                });
            } else {
                alert(`Partage de "${fileName}" - Copiez le lien: ${window.location.href}`);
            }
        }

        // Générer un rapport personnalisé
        async function generateCustomReport(event) {
            event.preventDefault();
            
            const formData = new FormData(event.target);
            const data = Object.fromEntries(formData.entries());
            const reportType = data.reportType || 'pdf';
            
            if (reportType === 'pdf') {
                showPdfModal();
            } else if (reportType === 'print') {
                window.print();
            } else {
                // Générer un rapport HTML
                try {
                    const reportData = {
                        user_stats: statisticsData.user_stats,
                        period: data.period,
                        format: data.format,
                        generated_at: new Date().toISOString()
                    };
                    
                    // Créer et télécharger le rapport HTML
                    const blob = new Blob([generateHtmlReport(reportData)], { type: 'text/html' });
                    const url = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = `rapport-statistiques-${Date.now()}.html`;
                    document.body.appendChild(a);
                    a.click();
                    window.URL.revokeObjectURL(url);
                    document.body.removeChild(a);
                    
                    addToReportHistory(`rapport-${Date.now()}.html`, 'html');
                    
                    showMessage('success', 'Rapport HTML généré avec succès!');
                } catch (error) {
                    console.error('Erreur:', error);
                    showError('Erreur lors de la génération du rapport');
                }
            }
        }

        // Générer un rapport HTML
        function generateHtmlReport(data) {
            return `
                <!DOCTYPE html>
                <html lang="fr">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Rapport Statistiques iVote</title>
                    <style>
                        body { font-family: Arial, sans-serif; margin: 40px; color: #333; }
                        h1 { color: #3b82f6; border-bottom: 2px solid #3b82f6; padding-bottom: 10px; }
                        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin: 20px 0; }
                        .stat-card { background: #f8fafc; padding: 20px; border-radius: 8px; border-left: 4px solid #3b82f6; }
                        .stat-value { font-size: 24px; font-weight: bold; color: #1e40af; }
                        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
                        th { background: #3b82f6; color: white; padding: 12px; text-align: left; }
                        td { padding: 10px; border-bottom: 1px solid #e5e7eb; }
                        .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid #ddd; color: #666; font-size: 12px; }
                    </style>
                </head>
                <body>
                    <h1>Rapport Statistiques iVote</h1>
                    <p>Généré le ${new Date().toLocaleDateString('fr-FR', { 
                        year: 'numeric', 
                        month: 'long', 
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    })}</p>
                    
                    <h2>Statistiques Principales</h2>
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-label">Sondages créés</div>
                            <div class="stat-value">${data.user_stats?.total_polls_created || 0}</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Votes reçus</div>
                            <div class="stat-value">${data.user_stats?.total_votes_cast || 0}</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Sondages actifs</div>
                            <div class="stat-value">${data.user_stats?.active_polls || 0}</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Sondages terminés</div>
                            <div class="stat-value">${data.user_stats?.closed_polls || 0}</div>
                        </div>
                    </div>
                    
                    <h2>Analyse de Période</h2>
                    <p>Période analysée: ${data.period === '7' ? '7 derniers jours' : 
                                        data.period === '30' ? '30 derniers jours' : 
                                        data.period === '90' ? '90 derniers jours' : 
                                        'Toute la période'}</p>
                    
                    <h2>Format du Rapport</h2>
                    <p>Format: ${data.format === 'summary' ? 'Résumé' : 
                               data.format === 'detailed' ? 'Détaillé' : 
                               'Exécutif'}</p>
                    
                    <div class="footer">
                        <p>Ce rapport a été généré automatiquement par iVote Analytics.</p>
                        <p>© ${new Date().getFullYear()} iVote - Tous droits réservés.</p>
                    </div>
                </body>
                </html>
            `;
        }

        // Afficher un message
        function showMessage(type, text) {
            const container = document.querySelector('.container');
            
            // Supprimer les anciens messages
            document.querySelectorAll('.message').forEach(msg => msg.remove());
            
            const messageDiv = document.createElement('div');
            messageDiv.className = `message bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-lg shadow-md fade-in`;
            messageDiv.innerHTML = `
                <div class="flex items-center">
                    <span class="material-icons mr-3 text-green-500">check_circle</span>
                    <p class="flex-1">${text}</p>
                    <button onclick="this.parentElement.parentElement.remove()" 
                            class="text-green-400 hover:text-green-600">
                        <span class="material-icons">close</span>
                    </button>
                </div>
            `;
            
            if (container.firstChild) {
                container.insertBefore(messageDiv, container.firstChild);
            }
            
            setTimeout(() => {
                if (messageDiv.parentElement) {
                    messageDiv.remove();
                }
            }, 5000);
        }

        // Afficher une erreur
        function showError(message) {
            const container = document.querySelector('.container');
            
            // Supprimer les anciennes erreurs
            document.querySelectorAll('.error-message').forEach(error => error.remove());
            
            const errorDiv = document.createElement('div');
            errorDiv.className = 'error-message bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-lg shadow-md fade-in';
            errorDiv.innerHTML = `
                <div class="flex items-center">
                    <span class="material-icons mr-3 text-red-500">error</span>
                    <div class="flex-1">
                        <p class="font-medium">Erreur</p>
                        <p class="text-sm mt-1">${message}</p>
                    </div>
                    <button onclick="this.parentElement.parentElement.remove()" 
                            class="text-red-400 hover:text-red-600">
                        <span class="material-icons">close</span>
                    </button>
                </div>
            `;
            
            if (container.firstChild) {
                container.insertBefore(errorDiv, container.firstChild);
            }
            
            setTimeout(() => {
                if (errorDiv.parentElement) {
                    errorDiv.remove();
                }
            }, 10000);
        }

        // Réessayer le chargement
        function retryLoadStatistics() {
            document.querySelectorAll('.error-message').forEach(error => error.remove());
            loadStatistics();
        }
    </script>
</body>
</html>