<!-- BIENVENUE -->
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-xl shadow-lg p-8 mb-8 text-white">
    <h1 class="text-3xl font-bold mb-2">👋 Bienvenue, <%= user.prenom %> !</h1>
    <p class="text-indigo-100">Voici un aperçu de votre activité sur iVote</p>
</div>

<!-- STATISTIQUES -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="stat-card bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-sm font-medium">Votes participés</p>
                <h3 class="text-4xl font-bold mt-2 text-indigo-600">
                    <%= stats.totalVotes %>
                </h3>
            </div>
            <div class="p-4 bg-indigo-50 rounded-xl">
                <span class="material-icons text-indigo-600 text-3xl">how_to_vote</span>
            </div>
        </div>
    </div>

    <div class="stat-card bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-sm font-medium">Sondages actifs</p>
                <h3 class="text-4xl font-bold mt-2 text-green-600">
                    <%= stats.activePolls %>
                </h3>
            </div>
            <div class="p-4 bg-green-50 rounded-xl">
                <span class="material-icons text-green-600 text-3xl">dynamic_feed</span>
            </div>
        </div>
    </div>

    <div class="stat-card bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-sm font-medium">Sondages terminés</p>
                <h3 class="text-4xl font-bold mt-2 text-purple-600">
                    <%= stats.completedPolls %>
                </h3>
            </div>
            <div class="p-4 bg-purple-50 rounded-xl">
                <span class="material-icons text-purple-600 text-3xl">check_circle</span>
            </div>
        </div>
    </div>

    <div class="stat-card bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-sm font-medium">Sondages créés</p>
                <h3 class="text-4xl font-bold mt-2 text-blue-600">
                    <%= stats.totalPollsCreated %>
                </h3>
            </div>
            <div class="p-4 bg-blue-50 rounded-xl">
                <span class="material-icons text-blue-600 text-3xl">poll</span>
            </div>
        </div>
    </div>

    <div class="stat-card bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-sm font-medium">Rooms rejointes</p>
                <h3 class="text-4xl font-bold mt-2 text-orange-600">
                    <%= stats.totalRoomsJoined %>
                </h3>
            </div>
            <div class="p-4 bg-orange-50 rounded-xl">
                <span class="material-icons text-orange-600 text-3xl">meeting_room</span>
            </div>
        </div>
    </div>

    <div class="stat-card bg-white rounded-xl shadow-lg p-6 hover:shadow-xl transition-shadow">
        <div class="flex items-center justify-between">
            <div>
                <p class="text-gray-500 text-sm font-medium">Rooms créées</p>
                <h3 class="text-4xl font-bold mt-2 text-pink-600">
                    <%= stats.totalRoomsOwned %>
                </h3>
            </div>
            <div class="p-4 bg-pink-50 rounded-xl">
                <span class="material-icons text-pink-600 text-3xl">dashboard</span>
            </div>
        </div>
    </div>
</div>

<!-- ACTIONS RAPIDES -->
<div class="bg-white rounded-xl shadow-lg p-6 max-w-4xl mx-auto">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">⚡ Actions rapides</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a href="/vote"
            class="group flex items-center p-5 border-2 border-dashed border-indigo-200 rounded-xl hover:border-indigo-400 hover:bg-indigo-50 transition-all">
            <div class="p-3 bg-indigo-100 group-hover:bg-indigo-200 rounded-xl mr-4 transition-colors">
                <span class="material-icons text-indigo-600 text-2xl">add_circle</span>
            </div>
            <div>
                <h3 class="font-bold text-gray-800">Créer un sondage</h3>
                <p class="text-gray-500 text-sm">Lancez un nouveau vote</p>
            </div>
        </a>

        <a href="/rooms"
            class="group flex items-center p-5 border-2 border-dashed border-blue-200 rounded-xl hover:border-blue-400 hover:bg-blue-50 transition-all">
            <div class="p-3 bg-blue-100 group-hover:bg-blue-200 rounded-xl mr-4 transition-colors">
                <span class="material-icons text-blue-600 text-2xl">meeting_room</span>
            </div>
            <div>
                <h3 class="font-bold text-gray-800">Gérer mes rooms</h3>
                <p class="text-gray-500 text-sm">Organisez des votes en direct</p>
            </div>
        </a>

        

        <a href="/statistics"
            class="group flex items-center p-5 border-2 border-dashed border-green-200 rounded-xl hover:border-green-400 hover:bg-green-50 transition-all">
            <div class="p-3 bg-green-100 group-hover:bg-green-200 rounded-xl mr-4 transition-colors">
                <span class="material-icons text-green-600 text-2xl">bar_chart</span>
            </div>
            <div>
                <h3 class="font-bold text-gray-800">Statistiques</h3>
                <p class="text-gray-500 text-sm">Consultez vos performances</p>
            </div>
        </a>
    </div>
</div>

<style>
    .stat-card {
        animation: fadeInUp 0.5s ease-out;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>