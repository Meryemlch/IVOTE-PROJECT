<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rooms</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50">
    <div class="max-w-7xl mx-auto p-5">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8 flex-wrap gap-5">
            <div>
                <h1 class="text-3xl font-bold text-gray-900">Rooms</h1>
                <p class="text-gray-600">Rejoignez ou créez des salles de discussion et de votes</p>
            </div>
            <button onclick="openCreateRoomModal()" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition">
                <i class="fas fa-plus"></i> Créer une Room
            </button>
        </div>

        <!-- Filtres -->
        <div class="mb-5">
            <div class="relative mb-5">
                <input type="text" id="searchRooms" placeholder="Rechercher des rooms..." onkeyup="searchRooms()" 
                    class="w-full px-4 py-2 pr-12 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                <i class="fas fa-search absolute right-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
            </div>
            <div class="flex gap-2 flex-wrap">
                <button class="filter-tab px-4 py-2 border border-gray-300 rounded-lg bg-blue-500 text-white" onclick="setFilter('all')">Toutes</button>
                <button class="filter-tab px-4 py-2 border border-gray-300 rounded-lg bg-white hover:bg-gray-50" onclick="setFilter('my')">Mes Rooms</button>
                <button class="filter-tab px-4 py-2 border border-gray-300 rounded-lg bg-white hover:bg-gray-50" onclick="setFilter('public')">Publiques</button>
                <button class="filter-tab px-4 py-2 border border-gray-300 rounded-lg bg-white hover:bg-gray-50" onclick="setFilter('private')">Privées</button>
            </div>
        </div>

        <!-- Grid des rooms -->
        <div id="roomsGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mb-10">
            <!-- Les rooms seront chargées ici -->
        </div>

        <!-- État vide -->
        <div id="emptyState" class="hidden text-center py-16">
            <i class="fas fa-door-open text-6xl text-gray-400 mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-700 mb-2">Aucune room disponible</h3>
            <p class="text-gray-600 mb-4">Soyez le premier à créer une room !</p>
            <button onclick="openCreateRoomModal()" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg">
                <i class="fas fa-plus"></i> Créer ma première Room
            </button>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="hidden flex justify-center gap-2 mt-8"></div>
    </div>

    <!-- Modal de création de room -->
    <div id="createRoomModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl p-8 w-full max-w-lg max-h-[90vh] overflow-y-auto">
            <h2 class="text-2xl font-bold mb-6">Créer une Room</h2>
            <form id="createRoomForm">
                <div class="mb-5">
                    <label for="roomName" class="block mb-2 font-medium text-gray-700">Nom de la room *</label>
                    <input type="text" id="roomName" required maxlength="100" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="mb-5">
                    <label for="roomDescription" class="block mb-2 font-medium text-gray-700">Description</label>
                    <textarea id="roomDescription" rows="4" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                </div>

                <div class="mb-5">
                    <label for="roomType" class="block mb-2 font-medium text-gray-700">Type de room</label>
                    <select id="roomType" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="public">Publique</option>
                        <option value="private">Privée</option>
                    </select>
                </div>

                <div class="mb-5">
                    <label for="maxMembers" class="block mb-2 font-medium text-gray-700">Nombre maximum de membres</label>
                    <input type="number" id="maxMembers" min="2" max="1000" value="100" 
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>

                <div id="accessCodeSection" class="hidden mt-4 p-4 bg-gray-50 rounded-lg">
                    <label class="block mb-2 font-medium text-gray-700">Code d'accès généré :</label>
                    <div id="generatedCode" class="text-center text-2xl font-bold text-green-600 bg-white py-3 rounded-lg border-2 border-dashed border-green-500 font-mono"></div>
                    <p class="text-sm text-gray-500 mt-2">Ce code est requis pour rejoindre la room</p>
                </div>

                <div class="flex justify-end gap-3 mt-8">
                    <button type="button" onclick="closeCreateRoomModal()" 
                        class="px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50">Annuler</button>
                    <button type="submit" class="px-6 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg">Créer la Room</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        let currentFilter = 'all';
        let currentPage = 1;
        const roomsPerPage = 9;

        document.addEventListener('DOMContentLoaded', function() {
            loadRooms();
            setupRoomTypeListener();
        });

        function setupRoomTypeListener() {
            const roomTypeSelect = document.getElementById('roomType');
            const accessCodeSection = document.getElementById('accessCodeSection');
            
            roomTypeSelect.addEventListener('change', function() {
                if (this.value === 'private') {
                    accessCodeSection.classList.remove('hidden');
                    generateAccessCode();
                } else {
                    accessCodeSection.classList.add('hidden');
                }
            });
        }

        function generateAccessCode() {
            const code = Math.random().toString(36).substring(2, 8).toUpperCase();
            document.getElementById('generatedCode').textContent = code;
        }

        function openCreateRoomModal() {
            document.getElementById('createRoomModal').classList.remove('hidden');
            generateAccessCode();
        }

        function closeCreateRoomModal() {
            document.getElementById('createRoomModal').classList.add('hidden');
            document.getElementById('createRoomForm').reset();
        }

        document.getElementById('createRoomForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const roomData = {
                name: document.getElementById('roomName').value,
                description: document.getElementById('roomDescription').value,
                room_type: document.getElementById('roomType').value,
                max_members: parseInt(document.getElementById('maxMembers').value)
            };

            if (roomData.room_type === 'private') {
                roomData.access_code = document.getElementById('generatedCode').textContent;
            }

            try {
                const response = await fetch('/api/rooms', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(roomData)
                });

                const result = await response.json();
                
                if (result.success) {
                    showToast('Room créée avec succès!', 'success');
                    closeCreateRoomModal();
                    loadRooms();
                } else {
                    showToast(result.message || 'Erreur lors de la création', 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showToast('Erreur de connexion', 'error');
            }
        });

        async function loadRooms(page = 1) {
            try {
                const response = await fetch(`/api/rooms?filter=${currentFilter}&page=${page}&limit=${roomsPerPage}`);
                const result = await response.json();
                
                if (result.success) {
                    renderRooms(result.rooms);
                    renderPagination(result.totalPages, page);
                }
            } catch (error) {
                console.error('Erreur:', error);
            }
        }

        function renderRooms(rooms) {
            const roomsGrid = document.getElementById('roomsGrid');
            const emptyState = document.getElementById('emptyState');
            
            if (!rooms || rooms.length === 0) {
                roomsGrid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }
            
            emptyState.classList.add('hidden');
            
            roomsGrid.innerHTML = rooms.map(room => `
                <div class="bg-white rounded-xl p-5 shadow-md border border-gray-200 hover:shadow-lg hover:-translate-y-1 transition-all">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">${escapeHtml(room.name)}</h3>
                            <div class="flex gap-2 flex-wrap">
                                <span class="px-2 py-1 text-xs font-semibold rounded ${room.room_type === 'public' ? 'bg-blue-100 text-blue-700' : 'bg-pink-100 text-pink-700'} uppercase">
                                    ${room.room_type === 'public' ? 'Publique' : 'Privée'}
                                </span>
                                <span class="px-2 py-1 text-xs font-semibold rounded ${getStatusClass(room.status)}">
                                    ${getStatusText(room.status)}
                                </span>
                            </div>
                        </div>
                        ${room.is_owner ? '<span class="px-2 py-1 text-xs font-semibold rounded bg-blue-500 text-white">Propriétaire</span>' : ''}
                    </div>
                    
                    ${room.description ? `<p class="text-gray-600 text-sm mb-4">${escapeHtml(room.description)}</p>` : ''}
                    
                    <div class="text-sm text-gray-600 mb-4">
                        <i class="fas fa-user"></i> Créée par ${escapeHtml(room.owner_name)}
                    </div>
                    
                    <div class="flex gap-4 mb-4 text-sm text-gray-600">
                        <div class="flex items-center gap-1">
                            <i class="fas fa-users"></i>
                            <span>${room.current_members} <span class="text-gray-400">/ ${room.max_members}</span></span>
                        </div>
                        <div class="flex items-center gap-1">
                            <i class="far fa-clock"></i>
                            <span>${formatDate(room.created_at)}</span>
                        </div>
                    </div>
                    
                    <div class="flex gap-2">
                        ${room.is_member ? `
                            <button onclick="enterRoom(${room.id})" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">
                                <i class="fas fa-door-open"></i> Entrer
                            </button>
                        ` : `
                            ${room.room_type === 'private' ? `
                                <button onclick="showJoinPrivateRoom(${room.id})" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">
                                    <i class="fas fa-key"></i> Rejoindre avec code
                                </button>
                            ` : `
                                <button onclick="joinRoom(${room.id})" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">
                                    <i class="fas fa-sign-in-alt"></i> Rejoindre
                                </button>
                            `}
                        `}
                        
                        ${room.is_owner ? `
                            <button onclick="manageRoom(${room.id})" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm">
                                <i class="fas fa-cog"></i> Gérer
                            </button>
                        ` : `
                            <!-- NOUVEAU BOUTON POUR LA VUE UTILISATEUR -->
                            <a href="/room/${room.id}/user-view" 
                               class="inline-block text-center bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg text-sm transition">
                               <i class="fas fa-eye"></i> Détails
                            </a>
                        `}
                    </div>
                </div>
            `).join('');
        }

        function renderPagination(totalPages, currentPage) {
            const pagination = document.getElementById('pagination');
            
            if (totalPages <= 1) {
                pagination.classList.add('hidden');
                return;
            }
            
            pagination.classList.remove('hidden');
            
            let pagesHtml = '';
            
            if (currentPage > 1) {
                pagesHtml += `<button onclick="loadRooms(${currentPage - 1})" class="px-3 py-2 border border-gray-300 rounded-lg bg-white hover:bg-gray-50">&lt;</button>`;
            }
            
            for (let i = 1; i <= totalPages; i++) {
                pagesHtml += `
                    <button onclick="loadRooms(${i})" class="px-4 py-2 border rounded-lg ${i === currentPage ? 'bg-blue-500 text-white border-blue-500' : 'bg-white border-gray-300 hover:bg-gray-50'}">
                        ${i}
                    </button>
                `;
            }
            
            if (currentPage < totalPages) {
                pagesHtml += `<button onclick="loadRooms(${currentPage + 1})" class="px-3 py-2 border border-gray-300 rounded-lg bg-white hover:bg-gray-50">&gt;</button>`;
            }
            
            pagination.innerHTML = pagesHtml;
        }

        function setFilter(filter) {
            currentFilter = filter;
            currentPage = 1;
            
            document.querySelectorAll('.filter-tab').forEach(tab => {
                tab.classList.remove('bg-blue-500', 'text-white');
                tab.classList.add('bg-white');
            });
            event.target.classList.add('bg-blue-500', 'text-white');
            event.target.classList.remove('bg-white');
            
            loadRooms();
        }

        function searchRooms() {
            const searchTerm = document.getElementById('searchRooms').value.toLowerCase();
            const roomCards = document.querySelectorAll('#roomsGrid > div');
            
            roomCards.forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(searchTerm) ? 'block' : 'none';
            });
        }

        async function joinRoom(roomId) {
            try {
                const response = await fetch(`/api/rooms/${roomId}/join`, {
                    method: 'POST'
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showToast('Vous avez rejoint la room!', 'success');
                    loadRooms();
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showToast('Erreur de connexion', 'error');
            }
        }

        function showJoinPrivateRoom(roomId) {
            const code = prompt('Veuillez entrer le code d\'accès:');
            if (code) {
                joinPrivateRoom(roomId, code);
            }
        }

        async function joinPrivateRoom(roomId, code) {
            try {
                const response = await fetch(`/api/rooms/${roomId}/join`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ access_code: code })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    showToast('Vous avez rejoint la room!', 'success');
                    loadRooms();
                } else {
                    showToast(result.message, 'error');
                }
            } catch (error) {
                console.error('Erreur:', error);
                showToast('Erreur de connexion', 'error');
            }
        }

        function enterRoom(roomId) {
            window.location.href = `/room/${roomId}`;
        }

        function manageRoom(roomId) {
            window.location.href = `/room/${roomId}/manage`;
        }

        // Fonction gardée pour compatibilité, mais l'utilisateur sera redirigé par le lien direct
        function showRoomDetails(roomId) {
            window.location.href = `/room/${roomId}/user-view`;
        }

        function getStatusClass(status) {
            const classes = {
                'active': 'bg-green-100 text-green-700',
                'closed': 'bg-yellow-100 text-yellow-700',
                'archived': 'bg-gray-100 text-gray-700'
            };
            return classes[status] || 'bg-gray-100 text-gray-700';
        }

        function getStatusText(status) {
            const statusMap = {
                'active': 'Active',
                'closed': 'Fermée',
                'archived': 'Archivée'
            };
            return statusMap[status] || status;
        }

        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fr-FR', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function showToast(message, type = 'info') {
            let toastContainer = document.getElementById('toastContainer');
            if (!toastContainer) {
                toastContainer = document.createElement('div');
                toastContainer.id = 'toastContainer';
                toastContainer.className = 'fixed top-5 right-5 z-50 flex flex-col gap-2';
                document.body.appendChild(toastContainer);
            }
            
            const colors = {
                error: 'border-red-500',
                success: 'border-green-500',
                warning: 'border-yellow-500',
                info: 'border-blue-500'
            };
            
            const iconColors = {
                error: 'text-red-500',
                success: 'text-green-500',
                warning: 'text-yellow-500',
                info: 'text-blue-500'
            };
            
            const icons = {
                error: 'exclamation-circle',
                success: 'check-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            };
            
            const toast = document.createElement('div');
            toast.className = `bg-white text-gray-900 px-4 py-3 rounded-lg shadow-lg border-l-4 ${colors[type]} flex items-center gap-3 min-w-[300px] max-w-[400px] animate-slide-in`;
            
            toast.innerHTML = `
                <i class="fas fa-${icons[type]} ${iconColors[type]} text-xl"></i>
                <span>${escapeHtml(message)}</span>
            `;
            
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => {
                    if (toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }
                }, 300);
            }, 5000);
        }
    </script>

    <style>
        @keyframes slide-in {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        .animate-slide-in {
            animation: slide-in 0.3s ease-out;
        }
        
        /* Style pour les liens */
        a:hover {
            opacity: 0.9;
        }
    </style>
</body>
</html>