<div class="max-w-5xl mx-auto">
    <!-- Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800 mb-2">
            <i class="fas fa-search text-blue-500 mr-2"></i>
            Recherche
        </h1>
        <p class="text-gray-600">
            <% if (query) { %>
                Résultats pour "<%= query %>"
                    <% } else { %>
                        Recherchez des rooms et sondages
                        <% } %>
        </p>
    </div>

    <!-- Search Form -->
    <div class="bg-white rounded-xl shadow-md p-6 mb-8">
        <form action="/search" method="GET" class="flex gap-4">
            <div class="flex-1 relative">
                <input type="text" name="q" value="<%= query %>" placeholder="Rechercher des rooms, sondages..."
                    class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <i class="fas fa-search absolute left-4 top-4 text-gray-400"></i>
            </div>
            <button type="submit"
                class="px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition">
                Rechercher
            </button>
        </form>
    </div>

    <!-- Filter Tabs -->
    <% if (query) { %>
        <div class="flex gap-2 mb-6">
            <button onclick="filterResults('all')" id="filter-all"
                class="filter-btn active px-4 py-2 rounded-lg bg-blue-600 text-white font-medium">
                Tout
            </button>
            <button onclick="filterResults('rooms')" id="filter-rooms"
                class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300">
                <i class="fas fa-door-open mr-1"></i> Rooms
            </button>
            <button onclick="filterResults('polls')" id="filter-polls"
                class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-medium hover:bg-gray-300">
                <i class="fas fa-poll mr-1"></i> Sondages
            </button>
        </div>
        <% } %>

            <!-- Results -->
            <div id="searchResults">
                <% if (!query) { %>
                    <div class="text-center py-12">
                        <i class="fas fa-search text-6xl text-gray-300 mb-4"></i>
                        <h3 class="text-xl font-medium text-gray-600 mb-2">Lancez une recherche</h3>
                        <p class="text-gray-500">Entrez un terme pour rechercher des rooms et sondages</p>
                    </div>
                    <% } else { %>
                        <div id="resultsContainer">
                            <div class="flex justify-center py-8">
                                <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
                            </div>
                        </div>
                        <% } %>
            </div>
</div>

<style>
    .result-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        padding: 20px;
        margin-bottom: 16px;
        border: 1px solid #e5e7eb;
    }

    .filter-btn.active {
        background-color: #2563eb !important;
        color: white !important;
    }
</style>

<script>
    let allResults = { rooms: [], polls: [] };
    let currentFilter = 'all';

    document.addEventListener('DOMContentLoaded', function () {
        const query = '<%= query %>';
        if (query && query.trim()) {
            performSearch(query);
        }
    });

    async function performSearch(query) {
        const container = document.getElementById('resultsContainer');

        try {
            const response = await fetch(`/api/rooms?search=${encodeURIComponent(query)}`);
            const data = await response.json();

            allResults.rooms = data.success && data.rooms ? data.rooms : [];
            allResults.polls = []; // Sondages seront affichés à partir des rooms

            renderResults();

        } catch (error) {
            console.error('Erreur recherche:', error);
            container.innerHTML = `
                <div class="text-center py-12">
                    <i class="fas fa-exclamation-triangle text-6xl text-red-300 mb-4"></i>
                    <h3 class="text-xl font-medium text-gray-600 mb-2">Erreur</h3>
                    <p class="text-gray-500">Une erreur est survenue lors de la recherche</p>
                </div>
            `;
        }
    }

    function filterResults(type) {
        currentFilter = type;

        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active', 'bg-blue-600', 'text-white');
            btn.classList.add('bg-gray-200', 'text-gray-700');
        });
        const activeBtn = document.getElementById(`filter-${type}`);
        if (activeBtn) {
            activeBtn.classList.remove('bg-gray-200', 'text-gray-700');
            activeBtn.classList.add('active', 'bg-blue-600', 'text-white');
        }

        renderResults();
    }

    function renderResults() {
        const container = document.getElementById('resultsContainer');
        let html = '';
        let totalResults = 0;

        // Rooms
        if (currentFilter === 'all' || currentFilter === 'rooms') {
            allResults.rooms.forEach(room => {
                totalResults++;
                html += `
                    <div class="result-card" data-type="room">
                        <div class="flex items-start gap-4">
                            <div class="w-14 h-14 rounded-lg bg-purple-100 flex items-center justify-center flex-shrink-0">
                                <i class="fas fa-door-open text-purple-600 text-2xl"></i>
                            </div>
                            <div class="flex-1">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <span class="text-xs font-semibold text-purple-600 bg-purple-100 px-2 py-1 rounded">Room</span>
                                        <h3 class="font-bold text-gray-800 text-lg mt-1">${escapeHtml(room.name)}</h3>
                                    </div>
                                    <span class="px-3 py-1 text-xs rounded-full font-medium ${room.room_type === 'public' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}">
                                        <i class="fas ${room.room_type === 'public' ? 'fa-globe' : 'fa-lock'} mr-1"></i>
                                        ${room.room_type === 'public' ? 'Publique' : 'Privée'}
                                    </span>
                                </div>
                                <p class="text-gray-600 mb-3">${escapeHtml(room.description || 'Aucune description')}</p>
                                <div class="flex gap-4 text-sm text-gray-500">
                                    <span><i class="fas fa-users mr-1"></i> ${room.current_members || 0} membres</span>
                                    <span><i class="fas fa-calendar mr-1"></i> ${formatDate(room.created_at)}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
        }

        // Sondages (affichés à partir des rooms avec lien d'accès)
        if (currentFilter === 'all' || currentFilter === 'polls') {
            allResults.rooms.forEach(room => {
                if (room.polls_count && room.polls_count > 0) {
                    totalResults++;
                    html += `
                        <div class="result-card" data-type="poll">
                            <div class="flex items-start gap-4">
                                <div class="w-14 h-14 rounded-lg bg-orange-100 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-poll text-orange-600 text-2xl"></i>
                                </div>
                                <div class="flex-1">
                                    <div class="flex justify-between items-start mb-2">
                                        <div>
                                            <span class="text-xs font-semibold text-orange-600 bg-orange-100 px-2 py-1 rounded">Sondages</span>
                                            <h3 class="font-bold text-gray-800 text-lg mt-1">${room.polls_count} sondage(s) dans "${escapeHtml(room.name)}"</h3>
                                        </div>
                                    </div>
                                    <p class="text-gray-600 mb-3">Cette room contient des sondages auxquels vous pouvez participer si vous êtes membre.</p>
                                    <div class="flex justify-between items-center">
                                        <span class="text-sm text-gray-500"><i class="fas fa-vote-yea mr-1"></i> ${room.polls_count} sondage(s) disponible(s)</span>
                                        <a href="/room/${room.id}/polls" class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600 transition font-medium text-sm">
                                            <i class="fas fa-arrow-right mr-1"></i> Voir les sondages
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }
            });
        }

        if (totalResults === 0) {
            html = `
                <div class="text-center py-12">
                    <i class="fas fa-search text-6xl text-gray-300 mb-4"></i>
                    <h3 class="text-xl font-medium text-gray-600 mb-2">Aucun résultat</h3>
                    <p class="text-gray-500">Aucun résultat trouvé pour cette recherche</p>
                </div>
            `;
        } else {
            html = `<p class="text-gray-600 mb-4">${totalResults} résultat(s) trouvé(s)</p>` + html;
        }

        container.innerHTML = html;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function formatDate(dateStr) {
        if (!dateStr) return 'N/A';
        const date = new Date(dateStr);
        return date.toLocaleDateString('fr-FR');
    }
</script>